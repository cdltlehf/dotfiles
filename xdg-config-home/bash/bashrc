#!/bin/bash

: "${XDG_CONFIG_HOME:="${HOME}/.config"}"
SHRC="${XDG_CONFIG_HOME}/sh/shrc"
[[ -e "${SHRC}" ]] && source "${SHRC}"

shopt -s globstar 2> /dev/null || true

unset PROMPT_COMMAND
BASHRCDIR="${XDG_CONFIG_HOME}/bash/bashrc.d"
if [[ -d "${BASHRCDIR}" ]]; then
  for sh in "${BASHRCDIR}"/*.bash; do
    source "${sh}"
  done
  unset -v sh
fi

[[ -f "${HOME}/.bashrc.local" ]] && source "${HOME}/.bashrc.local" 2> /dev/null || true
