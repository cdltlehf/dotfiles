# shellcheck shell=bash
#
# Reference: https://www.gnu.org/software/bash/manual/html_node/Bash-Startup-Files.html

# shellcheck source=/dev/null
[[ -e "${HOME}/.profile" ]] && source "${HOME}/.profile"

if [[ -x "/opt/homebrew/bin/brew" ]]; then
  __cached /opt/homebrew/bin/brew shellenv
elif [[ -x "/usr/local/bin/brew" ]]; then
  __cached /usr/local/bin/brew shellenv
fi

__pathmunge "${HOME}/.local/share/mise/shims"
__pathmunge "${HOME}/.local/bin"

# shellcheck source=/dev/null
[[ -f "${HOME}/.bashrc" ]] && source "${HOME}/.bashrc"
