# Reference: https://ghostty.org/docs/config/reference

# window-colorspace = display-p3
adjust-cell-height = 20%
background-blur = macos-glass-regular
background-opacity = 0.9
copy-on-select = clipboard
# Pass Shift+Space through to IME for Korean input toggle (구름 입력기 한/영 전환)
keybind = shift+space=unbind
theme = "Modus Vivendi"
window-padding-balance = true
window-padding-x = 6
window-padding-y = 6

font-family = "JetBrains Mono"
font-family = "D2Coding"
font-family = "Symbols Nerd Font"

font-codepoint-map = U+1100-U+11FF=D2Coding
font-codepoint-map = U+3130-U+318F=D2Coding
font-codepoint-map = U+AC00-U+D7AF=D2Coding

title = ""
shell-integration-features = no-title

env = LC_TERMINAL_GLYPHS=nerdfont
