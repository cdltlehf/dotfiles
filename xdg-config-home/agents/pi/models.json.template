{
  "$schema": "https://pi.dev/schemas/models.schema.json",
  "providers": {
    "local": {
      "api": "openai-completions",
      "apiKey": "${API_KEY}",
      "baseUrl": "${API_BASE_URL}",
      "models": [
        {
          "contextWindow": 16384,
          "id": "${API_MODEL}",
          "input": ["text", "image"],
          "maxTokens": 4096,
          "reasoning": true,
          "thinkingLevelMap": {
            "off": "none"
          }
        }
      ]
    }
  }
}
