; See more:
; https://github.com/tj/git-extras
; https://blog.gitbutler.com/how-git-core-devs-configure-git/
[alias]
	; https://git-scm.com/book/en/v2/Git-Basics-Git-Aliases
	co = checkout
	sw = switch
	swc = switch -c
	br = branch
	ci = commit
	st = status
	rs = restore
	rss = restore --staged
	unstage = reset HEAD --
	last = log -1 HEAD
	; misc
	cim = commit --message
	sts = status --short
	root = rev-parse --show-toplevel
	ls-untracked = ls-files --others --exclude-standard
	lg = log --color --graph --oneline --abbrev-commit --decorate
	alias = !git config --get-regexp 'alias.*' \
		| sed 's/^alias\\.//' | sed 's/ / = /' | sed 's/ \\+/ /g' \
		| sort
	bclean = "!f() { git checkout main && git fetch --prune && git branch --merged | grep -v * | xargs -n 1 git branch -d; }; f"

[color]
	ui = auto
	diff = auto
	status = auto
	branch = auto
	interactive = auto
	grep = auto

[column]
	ui = auto
[branch]
	sort = -committerdate
[tag]
	sort = version:refname
[init]
	defaultBranch = main
[diff]
	algorithm = histogram
	colorMoved = plain
	mnemonicPrefix = true
	renames = true
	tool = nvimdiff
[difftool]
	prompt = false
[merge]
	tool = nvimdiff
[mergetool]
	prompt = false
	keepBackup = false
[push]
	default = simple
	autoSetupRemote = true
	followTags = true
[fetch]
	prune = true
	pruneTags = true
	all = true

[status]
	showStash = true

[help]
	autocorrect = prompt

[commit]
	verbose = true
	template = "~/.config/git/gitmessage"
[rerere]
	autoupdate = true
	enabled = true
[core]
	pager = delta
	excludesfile = "~/.config/git/ignore"
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	light = false
	line-numbers = true
[rebase]
	autoSquash = true
	autoStash = true
	updateRefs = true

[pull]
	rebase = true

[user]
	useConfigOnly = true

[include]
	path = "~/.gitconfig.local"
