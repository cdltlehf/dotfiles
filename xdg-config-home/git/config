; Reference: https://github.com/tj/git-extras
; Reference: https://blog.gitbutler.com/how-git-core-devs-configure-git/
; Reference: https://git-scm.com/book/en/v2/Git-Basics-Git-Aliases
; Reference: https://stackoverflow.com/questions/1057564/pretty-git-branch-graphs

[alias]
	sw = switch
	br = branch
	ci = commit
	st = status
	rs = restore
	unstage = restore --staged
	ff = merge --ff-only
	last = log -1 HEAD
	root = rev-parse --show-toplevel
	lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset'
	alias = "!git config --get-regexp '^alias\\.' \
		| sed 's/^alias\\.//; s/ /\t/' \
		| sort \
		| column -t -s '\t' \
		| awk '{printf \"\\033[36m%s\\033[0m%s\\n\", $1, substr($0, length($1)+1)}'"
	bclean = "!f() { git branch --merged ${1:-HEAD} --format='%(refname:short)' | grep -v -E '^(main|master|develop)$' | xargs -r git branch -d; }; f"

[color]
	ui = auto

[column]
	ui = auto
[branch]
	sort = -committerdate
[tag]
	sort = version:refname
[diff]
	algorithm = histogram
	colorMoved = plain
	mnemonicPrefix = true
	renames = true
	tool = nvimdiff
[difftool]
	prompt = false
[merge]
	conflictStyle = zdiff3
	tool = nvimdiff
[mergetool]
	prompt = false
	keepBackup = false
[push]
	default = simple
	autoSetupRemote = true
	followTags = true
[fetch]
	prune = true
	pruneTags = true
	all = true

[status]
	showStash = true

[help]
	autocorrect = prompt

[commit]
	verbose = true
	template = "~/.config/git/gitmessage"
[rerere]
	autoupdate = true
	enabled = true
[core]
	excludesfile = "~/.config/git/ignore"
[rebase]
	autoSquash = true
	autoStash = true
	updateRefs = true

[pull]
	rebase = true

[user]
	useConfigOnly = true

[include]
	path = "~/.gitconfig.local"
