# shellcheck shell=sh
# POSIX shell startup file for an interactive login shell
#
# Reference: https://pubs.opengroup.org/onlinepubs/9699919799/utilities/sh.html

: "${XDG_CONFIG_HOME:="${HOME}/.config"}"
if [ -f "${XDG_CONFIG_HOME}/sh/env.sh" ]; then
  # shellcheck source=/dev/null
  . "${XDG_CONFIG_HOME}/sh/env.sh"
fi

# Re-assert Homebrew and user paths after macOS /etc/zprofile path_helper
if [ -n "${HOMEBREW_PREFIX:-}" ] && [ -x "/opt/homebrew/bin/brew" ]; then
  eval "$(/opt/homebrew/bin/brew shellenv || true)"
elif [ -n "${HOMEBREW_PREFIX:-}" ] && [ -x "/usr/local/bin/brew" ]; then
  eval "$(/usr/local/bin/brew shellenv || true)"
fi

pathmunge "${HOME}/.local/share/mise/shims"
pathmunge "${HOME}/.local/bin"
export PATH
unset -f pathmunge
