#!/bin/bash
#
# Reference:
# - https://github.com/Homebrew/homebrew-bundle
# - https://github.com/Hammerspoon/Spoons

if [ -z "${basedir}" ]; then
	echo "It should be run from the main setup script." >&2
	exit 1
fi

if [ "$(uname)" != "Darwin" ]; then
	echo "This script is only for macOS (Darwin)." >&2
	exit 1
fi

xcode-select --install &>/dev/null || true

sudo -v

if [ "$(uname -m)" = "arm64" ]; then
	sudo softwareupdate --install-rosetta --agree-to-license 2>/dev/null || true
fi

if ! command -v brew &>/dev/null; then
	[ -x "/opt/homebrew/bin/brew" ] || [ -x "/usr/local/bin/brew" ] || \
		/bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
	[ -x "/opt/homebrew/bin/brew" ] && eval "$(/opt/homebrew/bin/brew shellenv)"
	[ -x "/usr/local/bin/brew" ] && eval "$(/usr/local/bin/brew shellenv)"
fi

export PATH="${HOME}/.local/bin:${PATH}"
if ! command -v zb &>/dev/null; then
	curl -fsSL https://zerobrew.rs/install | bash -s -- --no-modify-path
fi

brewfile="${basedir}/Brewfile"
command -v zb &>/dev/null && (zb bundle install -f "${brewfile}" || true)
brew bundle --file "${brewfile}"

"${basedir}"/macos/defaults/macos

# Hammerspoon: Link explicit configuration files (prevents Spoons/cache pollution)
mkdir -p "${HOME}/.hammerspoon"
symlink "${basedir}/macos/hammerspoon/init.lua" "${HOME}/.hammerspoon/init.lua"
symlink "${basedir}/macos/hammerspoon/modules" "${HOME}/.hammerspoon/modules"

# Übersicht
symlink "${basedir}/macos/ubersichtrc" "${HOME}/.ubersichtrc"

# iCloud Drive shortcut
symlink "${HOME}/Library/Mobile Documents/com~apple~CloudDocs" "${HOME}/iCloud"

SPOON_INSTALL_URL="https://github.com/Hammerspoon/Spoons/raw/master/Spoons/SpoonInstall.spoon.zip"
if [ ! -d "${HOME}/.hammerspoon/Spoons/SpoonInstall.spoon" ]; then
	mkdir -p "${HOME}/.hammerspoon/Spoons/"
	tmpzip=$(mktemp /tmp/SpoonInstall.XXXXXX)
	curl -L "${SPOON_INSTALL_URL}" -o "${tmpzip}"
	unzip -q "${tmpzip}" -d "${HOME}/.hammerspoon/Spoons/"
	rm "${tmpzip}"
	unset tmpzip
fi

# VS Code user settings (explicit allowlist symlink)
VSCODE_USER_DIR="${HOME}/Library/Application Support/Code/User"
if [ -d "${VSCODE_USER_DIR}" ] || command -v code &>/dev/null; then
	mkdir -p "${VSCODE_USER_DIR}"
	symlink "${basedir}/xdg-config-home/vscode/settings.json" "${VSCODE_USER_DIR}/settings.json"
fi

# Karabiner: Compile ERB template to karabiner.json
if command -v erb &>/dev/null && [ -f "${basedir}/xdg-config-home/karabiner/karabiner.json.erb" ]; then
	erb "${basedir}/xdg-config-home/karabiner/karabiner.json.erb" > "${basedir}/xdg-config-home/karabiner/karabiner.json"
fi
