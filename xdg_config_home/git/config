; See more:
; https://github.com/tj/git-extras
; https://blog.gitbutler.com/how-git-core-devs-configure-git/
[alias]
	; https://git-scm.com/book/en/v2/Git-Basics-Git-Aliases
	co = checkout
	br = branch
	ci = commit
	st = status
	unstage = reset HEAD --
	last = log -1 HEAD
	; misc
	cim = commit -m
	sts = status -s
	root = rev-parse --show-toplevel
	ls-untracked = ls-files --others --exclude-standard
	alias = !git config --get-regexp 'alias.*' \
		| sed 's/^alias\\.//' | sed 's/ / = /' | sed 's/ \\+/ /g' \
		| sort

[color]
	ui = auto
	diff = auto
	status = auto
	branch = auto
	interactive = auto
	grep = auto

[column]
	ui = auto
[branch]
	sort = -committerdate
[tag]
	sort = version:refname
[init]
	defaultBranch = main
[diff]
	algorithm = histogram
	colorMoved = plain
	mnemonicPrefix = true
	renames = true
[push]
	default = simple
	autoSetupRemote = true
	followTags = true
[fetch]
	prune = true
	pruneTags = true
	all = true

[help]
	autocorrect = prompt
[commit]
	verbose = true
[rerere]
	autoupdate = true
	enable = true
[core]
	excludesfile = "~/.gitignore"
[rebase]
	autoSquash = true
	autoStash = true
	updateRefs = true

[core]
	fsmonitor = true
	untrackedCache = true
[merge]
	; conflictstyle = zdiff3
[pull]
	; rebase = true

[commit]
	template = "~/.gitmessage"

[init]
	defaultBranch = main

[user]
	useConfigOnly = true

[include]
	path = "~/.gitconfig.local"
