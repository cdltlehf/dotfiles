; See more: https://github.com/tj/git-extras
[alias]
	; https://git-scm.com/book/en/v2/Git-Basics-Git-Aliases
	co = checkout
	br = branch
	ci = commit
	st = status
	unstage = reset HEAD --
	last = log -1 HEAD
	; misc
	cim = commit -m
	root = rev-parse --show-toplevel
	ls-untracked = ls-files --others --exclude-standard
	alias = !git config --get-regexp 'alias.*' \
		| sed 's/^alias\\.//' | sed 's/ / = /' | sed 's/ \\+/ /g' \
		| sort

[color]
	ui = auto
	diff = auto
	status = auto
	branch = auto
	interactive = auto
	grep = auto

[core]
	editor = vim
	pager = less -F

[pull]
	rebase = false

[commit]
	template = "~/.gitmessage"

[init]
	defaultBranch = main

[user]
	useConfigOnly = true

[include]
	path = "~/.gitconfig"
