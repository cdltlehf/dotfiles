" ~/.vim/vimrc
" :help :help
" https://learnvimscriptthehardway.stevelosh.com
" https://learnvim.irian.to

if &g:compatible
  set nocompatible
endif

" custom wrapper function for minpac#add with opt type
" https://github.com/k-takata/minpac/issues/113
function! s:pac_add(url, ...) abort
  let l:options = get(a:000, 0, {})
  call minpac#add(a:url, extend({'type': 'opt'}, l:options, 'force'))
endfunction

silent! packadd minpac
if exists('g:loaded_minpac')
  function! s:PackInit() abort
    packadd minpac

    call minpac#init()
    call s:pac_add('k-takata/minpac')

    call s:pac_add('tpope/vim-abolish')
    call s:pac_add('tpope/vim-commentary')
    call s:pac_add('tpope/vim-repeat')
    call s:pac_add('tpope/vim-surround')

    call s:pac_add('airblade/vim-gitgutter')
    call s:pac_add('tpope/vim-fugitive')
    call s:pac_add('justinmk/vim-dirvish')

    call s:pac_add('prabirshrestha/vim-lsp')
    call s:pac_add('mattn/vim-lsp-settings')

    call s:pac_add('prabirshrestha/asyncomplete.vim')
    call s:pac_add('prabirshrestha/asyncomplete-lsp.vim')

    call s:pac_add('sheerun/vim-polyglot')

    call s:pac_add('github/copilot.vim')

    call s:pac_add('junegunn/fzf',
          \ {'do': 'silent! packadd fzf | call fzf#install()'})
    call s:pac_add('junegunn/fzf.vim')

    call s:pac_add('ryanoasis/vim-devicons')
  endfunction

  command! PackUpdate source $MYVIMRC | call s:PackInit() | call minpac#update()
  command! PackClean  source $MYVIMRC | call s:PackInit() | call minpac#clean()
  command! PackStatus packadd minpac | call minpac#status()
endif

" Source files in vimrc.d/preload
for s:f in split(glob('~/.vim/vimrc.d/preload/*.vim'), '\n')
  execute 'source' s:f
endfor

silent! packadd vim-abolish
silent! packadd vim-commentary
silent! packadd vim-repeat
silent! packadd vim-surround

silent! packadd vim-gitgutter
silent! packadd vim-fugitive
silent! packadd vim-dirvish

silent! packadd vim-lsp
silent! packadd vim-lsp-settings

silent! packadd asyncomplete.vim
silent! packadd asyncomplete-lsp.vim

" silent! packadd vim-polyglot

silent! packadd copilot.vim

silent! packadd fzf
silent! packadd fzf.vim

silent! packadd vim-devicons

silent! packadd bufferline
silent! packadd sensible
silent! packadd statusline
silent! packadd unimpaired
silent packadd vim-scriptease

silent! colorscheme dracula16

" Source files in vimrc.d
for s:f in split(glob('~/.vim/vimrc.d/*.vim'), '\n')
  execute 'source' s:f
endfor

