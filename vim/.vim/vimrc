" " Dracula Color Palette {{{1
" https://spec.draculatheme.com/
let background='#282a36'
let foreground='#f8f8f2'
let selection='#44475a'
let comment='#6272a4'

let red='#ff5555'
let orange='#ffb86c'
let yellow='#f1fa8c'
let green='#50fa7b'
let purple='#bd93f9'
let cyan='#8be9fd'
let pink='#ff79c6'

" compatible, termguicolors, etc... {{{1
if &g:compatible
  set nocompatible
endif
set termguicolors
let &t_8f="\<Esc>[38;2;%lu;%lu;%lum"
let &t_8b="\<Esc>[48;2;%lu;%lu;%lum"

" Dracula {{{1
packadd! dracula
colorscheme dracula
" XXX: IDK how dangerous it is, but its for the iterm2's opaque setting :P
autocmd ColorScheme,VimEnter * hi Normal guibg=NONE ctermbg=NONE

" comment map {{{1
" TODO: unify these
function! SetPythonCommentMap() abort
  nnoremap <Leader>c<Space> mcI# <ESC>`c
  vnoremap <Leader>c<Space> :s\/^\/#\ 

  nnoremap gcc mcI# <ESC>`c
  vnoremap gc :s\/^\/#\
endfunction

augroup commentmap
  autocmd!
  autocmd FileType javascript 
        \ nnoremap <Leader>c<Space> mcI// <ESC>`c
  autocmd FileType c 
        \ nnoremap <Leader>c<Space> mcI// <ESC>`c
  autocmd FileType cpp 
        \ nnoremap <Leader>c<Space> mcI// <ESC>`c
augroup END

" miscellaneous settings {{{1
set number
set relativenumber
" set background=dark
set nowrap
set hidden
set ignorecase
set smartcase
set tabstop=2 softtabstop=2 shiftwidth=2 expandtab smarttab
set list
set showbreak=>\ 
set belloff=all

vnoremap < <gv
vnoremap > >gv
vnoremap * y/<C-R>"<CR>

nnoremap Q @@
nnoremap Y y$

nnoremap n nzz
nnoremap N Nzz

nnoremap <Leader>b<Space> :buffers <CR>:buffer
" nnoremap <Leader>b<Space> :ls <CR>:b
nnoremap <Leader><Leader> :b#<CR>

" set text width 79 {{{1
set colorcolumn=80
" set textwidth=79

" pop up menu {{{1
set completeopt=noinsert,preview,menuone
set pumheight=5

"TODO
augroup completion "{{{1
  autocmd!
  "autocmd CursorMovedI * execute('if pumvisible() normal! a')
  "
augroup END

augroup popupmenu "{{{1
  autocmd!
  autocmd ColorScheme,VimEnter * 
        \ execute 'highlight PmenuSel guibg='. purple .' guifg=#21222c'
augroup END

augroup runcmd "{{{1
  autocmd FileType python nnoremap <buffer> <Leader>r<Space> :!python %<CR>
augroup END

augroup filetype_vim "{{{1
  " TODO: make each comment maps use 'comments' or 'commentstring'
  autocmd!
  autocmd FileType vim 
        \ nnoremap <silent> <buffer> 
        \ <Leader>c<Space> 
        \ :if match(getline('.'), '^\s*" \?') ==# -1 <CR>:s/^\s*/\0" /<CR> 
        \ :else<CR>:s/^\(\s*\)" \?/\1/<CR> 
        \ :end<CR>

  autocmd FileType vim 
        \ vnoremap <silent> <buffer> 
        \ <Leader>c<Space> 
        \ :s/^\s*/\0" /<CR>

  autocmd FileType vim nnoremap <buffer> <Leader>r<Space>  
        \ :source %<CR>:echo "sourcing done"<CR>

  autocmd FileType vim 
        \ setlocal tabstop=2 softtabstop=2 shiftwidth=2
augroup END

augroup filetype_tex "{{{1
  " TODO: set snippet from file
  " TODO: add some input mode maps
  autocmd!
  autocmd FileType tex
        \ setlocal tabstop=2 softtabstop=2 shiftwidth=2
  autocmd FileType tex syntax spell toplevel

  " snippets {{{2
  " https://github.com/honza/vim-snippets/blob/master/snippets/tex.snippets
  " PREAMBLE
  autocmd FileType tex iabbrev <buffer> _nc
        \ \newcommand{<C-o>m1}[<C-o>m2]]{<C-o>m3}
        \<ESC>`1a

  " DOCUMENT
  " autocmd FileType tex iabbrev <buffer> _begin
        " \ \begin{<CR><C-o>m1}{c}<CR><C-o>m0<CR>\end{tabular}<ESC>
        " \<ESC>`1a

  autocmd FileType tex iabbrev <buffer> _mkt
        \ \maketitle

  autocmd FileType tex iabbrev <buffer> _tab
        \ \begin{tabular}{c}<CR><C-o>m1<CR>\end{tabular}<ESC>
        \<ESC>`1a

  autocmd FileType tex iabbrev <buffer> _center
        \ \begin{center}{c}<CR><C-o>m1\end{center}<ESC>
        \<ESC>`1a

  autocmd FileType tex iabbrev <buffer> _item
        \ \begin{itemize}<CR>\item<C-o>m1<CR>\end{itemize}<ESC>
        \<ESC>`1a

  autocmd FileType tex iabbrev <buffer> _enum
        \ \begin{enumerate}<CR>\item<C-o>m1<CR>\end{enumerate}<ESC>
        \<ESC>`1a

  " }}}

  " comment
  autocmd FileType tex nnoremap <silent> <buffer> <Leader>c<Space>
        \ :if match(getline('.'), '^\s*% \?') ==# -1 <CR>:s/^\s*/\0% /<CR>
        \ :else<CR>:s/^\(\s*\)% \?/\1/<CR>
        \ :end<CR>

  autocmd FileType tex vnoremap <silent> <buffer> <Leader>c<Space>
        \ :s/^\s*/\0% /<CR>

  autocmd FileType tex nnoremap <buffer> <Leader>r<Space>
        \ :!pdflatex -interaction=nonstopmode %<CR>
augroup END

" make .vim folder (0700) {{{1
if empty(glob($HOME . "/.vim"))
  call mkdir($HOME . "/.vim", 0700)
endif

" set spellcheck {{{1
if empty(glob($HOME . "/.vim/spell"))
  call mkdir($HOME . "/.vim/spell", 0700)
endif
set spell
set spellfile=$HOME/.vim/spell/spell.utf-8.add

" set backup, swap and undo {{{1
let &backupdir = expand('~/.local/share/vim/backup/')
let &directory = expand('~/.local/share/vim/swap/')
let &undodir = expand('~/.local/share/vim/undo/')
let g:netrw_home = expand('~/.local/share/vim/')
set undofile
if !isdirectory(&backupdir) | call mkdir(&backupdir, 'p') | endif
if !isdirectory(&directory) | call mkdir(&directory, 'p') | endif
if !isdirectory(&undodir) | call mkdir(&undodir, 'p') | endif

" set fold (zR/zM to open/close all folds) {{{1
set foldcolumn=2
execute 'highlight FoldColumn guibg=' . background . ' guifg=' . comment
augroup fold
  autocmd!
  autocmd BufRead * normal zR
  autocmd FileType vim setlocal foldmethod=marker
  autocmd FileType python setlocal foldmethod=indent
augroup END
