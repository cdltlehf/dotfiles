" ~/.vim/vimrc
" :help :help
" https://learnvimscriptthehardway.stevelosh.com
" https://learnvim.irian.to

if &g:compatible
  set nocompatible
endif

silent! packadd minpac
if exists('g:loaded_minpac')
  function! s:PackInit() abort
    packadd minpac

    call minpac#init()
    call minpac#add('k-takata/minpac', {'type': 'opt'})
    call minpac#add('dracula/vim', {'type': 'opt', 'name': 'dracula'})
    call minpac#add('airblade/vim-gitgutter', {'type': 'opt'})
    call minpac#add('preservim/tagbar')
    call minpac#add('justinmk/vim-dirvish', {'type': 'opt'})
    call minpac#add('tpope/vim-fugitive', {'type': 'opt'})
    call minpac#add('dense-analysis/ale')
    call minpac#add('prabirshrestha/vim-lsp', {'type': 'opt'})
    call minpac#add('mattn/vim-lsp-settings', {'type': 'opt'})
    call minpac#add('prabirshrestha/asyncomplete.vim', {'type': 'opt'})
    call minpac#add('prabirshrestha/asyncomplete-lsp.vim', {'type': 'opt'})
    call minpac#add('github/copilot.vim', {'type': 'opt'})
    call minpac#add('junegunn/fzf', {'type': 'opt', 'do': {-> fzf#install()}})
    call minpac#add('junegunn/fzf.vim')
  endfunction

  command! PackUpdate source $MYVIMRC | call s:PackInit() | call minpac#update()
  command! PackClean  source $MYVIMRC | call s:PackInit() | call minpac#clean()
  command! PackStatus packadd minpac | call minpac#status()
endif

silent! packadd dracula
silent! packadd vim-gitgutter
silent! packadd vim-dirvish
silent! packadd vim-fugitive
silent! packadd vim-lsp
silent! packadd vim-lsp-settings
silent! packadd ale
silent! packadd tagbar
silent! packadd fzf
silent! packadd fzf.vim
silent! packadd asyncomplete.vim
silent! packadd asyncomplete-lsp.vim
silent! packadd copilot.vim

" Source files in vimrc.d
for s:f in split(glob('~/.vim/vimrc.d/*.vim'), '\n')
  execute 'source' s:f
endfor

silent! colorscheme dracula

" :help 'termguicolors'
if has('termguicolors') | set termguicolors | endif

" :help xterm-true-color
" let &t_8f="\<esc>[38;2;%lu;%lu;%lum"
" let &t_8b="\<esc>[48;2;%lu;%lu;%lum"

" :help termcap-cursor-shape
if &term =~ "xterm"
  let &t_SI="\<esc>[5 q" " blinking bar
  let &t_SR="\<esc>[3 q" " blinking underline
  let &t_EI="\<esc>[0 q" " block
endif

" https://github.com/vim/vim/commit/e07e797db0c5ef1aafc650d8bb0d39fb052cf1e1
set ttimeout
set ttimeoutlen=100

" :help section
map [[ ?{<cr>w99[{
map ][ /{<cr>b99[{
map ]] j0[[%/{<cr>
map [] k$][%?}<cr>

" :help 'colorcolumn'
if exists('&colorcolumn') | set colorcolumn=81 | endif

" :help :helptags
silent! helptags ALL

set number
set relativenumber
set ignorecase
set smartcase
if has('persistent_undo') | set undofile | endif
set list
set visualbell
if exists('syntax') | set spell | endif

let &spellfile = expand('$HOME/.local/share/vim/spell/en.utf-8.add')
let s:spelldir = fnamemodify(&spellfile, ':p:h')
if !isdirectory(s:spelldir) | call mkdir(s:spelldir, 'p') | endif
unlet s:spelldir

cabbr <expr> %% expand('%:p:h')

xnoremap < <gv
xnoremap > >gv
nnoremap <silent> <leader>= mzHmygg=G'yz<cr>`z

nnoremap <leader>y "+y
nnoremap <leader>d "+d
nnoremap <leader>p "+p
xnoremap <leader>y "+y
xnoremap <leader>d "+d
xnoremap <leader>p "+p

" soure host-local vimrc
let s:vimrc_host = expand('$HOME/.vimrc.host')
if filereadable(s:vimrc_host) | execute "source " . s:vimrc_host | endif

command! Reload source $MYVIMRC
