" ~/.vim/vimrc
" :help :help
" https://learnvimscriptthehardway.stevelosh.com
" https://learnvim.irian.to

if &g:compatible
  set nocompatible
endif

packadd dracula
packadd vim-gitgutter
packadd vim-dirvish
packadd vim-fugitive
" packadd ale
packadd vim-lsp
packadd asyncomplete.vim
packadd asyncomplete-lsp.vim

" Sourde files in vimrc.d
for s:f in split(glob('~/.vim/vimrc.d/*.vim'), '\n')
  execute 'source' s:f
endfor

" :help filetype
filetype plugin indent on

" :help 'termguicolors'
if has('termguicolors') | set termguicolors | endif

" :help xterm-true-color
" let &t_8f="\<esc>[38;2;%lu;%lu;%lum"
" let &t_8b="\<esc>[48;2;%lu;%lu;%lum"

" :help termcap-cursor-shape
if &term =~ "xterm"
  let &t_SI="\<esc>[5 q" " blinking bar
  let &t_SR="\<esc>[3 q" " blinking underline
  let &t_EI="\<esc>[0 q" " block
endif


" https://github.com/vim/vim/commit/e07e797db0c5ef1aafc650d8bb0d39fb052cf1e1
set ttimeout
set ttimeoutlen=100


" :help section
map [[ ?{<cr>w99[{
map ][ /{<cr>b99[{
map ]] j0[[%/{<cr>
map [] k$][%?}<cr>


" :help 'colorcolumn'
if exists('&colorcolumn') | set colorcolumn=81 | endif


" :help :helptags
silent! helptags ALL


set number
set relativenumber
set ignorecase
set smartcase
if has('persistent_undo') | set undofile | endif
set list
set visualbell
if exists('syntax') | set spell | endif

let &spellfile = expand('$HOME/.local/share/vim/spell/en.utf-8.add')
let s:spelldir = fnamemodify(&spellfile, ':p:h')
if !isdirectory(s:spelldir) | call mkdir(s:spelldir, 'p') | endif
unlet s:spelldir

cabbr <expr> %% expand('%:p:h')

xnoremap < <gv
xnoremap > >gv
nnoremap <silent> <leader>= mzHmygg=G'yz<cr>`z

" soure host-local vimrc
let s:vimrc_host = expand('$HOME/.vimrc.host')
if filereadable(s:vimrc_host) | execute "source " . s:vimrc_host | endif

