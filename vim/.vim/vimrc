" Set nocompatible {{{1
if &g:compatible
  set nocompatible
endif

" Add packages {{{1
packadd! sensible
packadd! statusline
packadd! unimpaired
packadd! bufferline

packadd! dracula
" packadd! gitgutter

" termguicolors, etc... {{{1
set termguicolors
let &t_8f="\<Esc>[38;2;%lu;%lu;%lum"
let &t_8b="\<Esc>[48;2;%lu;%lu;%lum"

" Customize Dracula {{{1
colorscheme dracula
augroup dracula_customization
  autocmd!
  autocmd ColorScheme dracula
        \ hi Normal guibg=NONE ctermbg=NONE |
        \ hi DraculaComment cterm=italic |
        \ hi link VertSplit DraculaCommentBold |
        \ hi link FoldColumn DraculaCommentBold
augroup END

"Set fillchars {{{1
set fillchars+=vert:│,foldsep:│,foldopen:┌

" comment map {{{1
" TODO: unify these
function! SetPythonCommentMap() abort
  nnoremap <Leader>c<Space> mcI# <ESC>`c
  vnoremap <Leader>c<Space> :s\/^\/#\ 

  nnoremap gcc mcI# <ESC>`c
  vnoremap gc :s\/^\/#\
endfunction

augroup commentmap
  autocmd!
  autocmd FileType javascript 
        \ nnoremap <Leader>c<Space> mcI// <ESC>`c
  autocmd FileType c 
        \ nnoremap <Leader>c<Space> mcI// <ESC>`c
  autocmd FileType cpp 
        \ nnoremap <Leader>c<Space> mcI// <ESC>`c
augroup END

" miscellaneous settings {{{1
set number
set relativenumber
" set background=dark
set nowrap
set hidden
set ignorecase
set smartcase
set tabstop=2 softtabstop=2 shiftwidth=2 expandtab smarttab
set list
set showbreak=>\ 
set belloff=all

vnoremap < <gv
vnoremap > >gv
vnoremap * y/<C-R>"<CR>

nnoremap Q @@
nnoremap Y y$

nnoremap n nzz
nnoremap N Nzz

nnoremap <Leader>b<Space> :buffers <CR>:buffer
" nnoremap <Leader>b<Space> :ls <CR>:b
nnoremap <Leader><Leader> :b#<CR>

" set text width 79 {{{1
set colorcolumn=80
" set textwidth=79

" pop up menu {{{1
set completeopt=noinsert,preview,menuone
set pumheight=5

