" let &t_8b="\<esc>[48;2;%lu;%lu;%lum"

" :help termcap-cursor-shape
if &term =~ "xterm"
  let &t_SI="\<esc>[5 q" " blinking bar
  let &t_SR="\<esc>[3 q" " blinking underline
  let &t_EI="\<esc>[0 q" " block
endif
augroup termcap_cursor_shape
  autocmd!
  autocmd VimEnter * silent !echo -ne "\e[0 q"
augroup END

" https://github.com/vim/vim/commit/e07e797db0c5ef1aafc650d8bb0d39fb052cf1e1
set ttimeout
set ttimeoutlen=100

" :help section
map [[ ?{<cr>w99[{
map ][ /{<cr>b99[{
map ]] j0[[%/{<cr>
map [] k$][%?}<cr>

" :help 'colorcolumn'
if exists('&colorcolumn') | set colorcolumn=81 | endif

" :help :helptags
silent! helptags ALL

set number
set relativenumber
set ignorecase
set smartcase
if has('persistent_undo') | set undofile | endif
set list
set visualbell
if has('syntax') | set spell | endif
set nowrap

let &spellfile = expand('$HOME/.local/share/vim/spell/en.utf-8.add')
let s:spelldir = fnamemodify(&spellfile, ':p:h')
if !isdirectory(s:spelldir) | call mkdir(s:spelldir, 'p') | endif
unlet s:spelldir

cabbr <expr> %% expand('%:p:h')

xnoremap < <gv
xnoremap > >gv
nnoremap <silent> <leader>= mzHmygg=G'yz<cr>`z

" nnoremap <leader>y "+y
" nnoremap <leader>d "+d
" nnoremap <leader>p "+p
" xnoremap <leader>y "+y
" xnoremap <leader>d "+d
" xnoremap <leader>p "+p

if !has('nvim')
  augroup terminal_win_open
    autocmd!
    autocmd TerminalWinOpen *
          \ setlocal nobuflisted
          \|setlocal nospell
          \|setlocal colorcolumn=
  augroup end
endif

" source host-local vimrc
let s:vimrc_host = expand('$HOME/.vimrc.host')
if filereadable(s:vimrc_host) | execute "source " . s:vimrc_host | endif
setlocal tabstop=2 softtabstop=2 shiftwidth=2 expandtab smarttab

" :help last-pattern
command! Reload source $MYVIMRC | let @/ = ""

nnoremap <leader>rr :Reload<cr>
