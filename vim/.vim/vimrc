" ~/.vim/vimrc
" :help :help
" https://learnvimscriptthehardway.stevelosh.com
" https://learnvim.irian.to

if &g:compatible
  set nocompatible
endif

packadd dracula
packadd vim-gitgutter
packadd vim-dirvish
packadd vim-fugitive
" packadd ale
packadd vim-lsp
packadd asyncomplete.vim
packadd asyncomplete-lsp.vim

for s:f in split(glob('~/.vim/vimrc.d/*.vim'), '\n')
	execute 'source' s:f
endfor

set number
set undofile

" Set terminal-things
set termguicolors
let &t_8f="\<esc>[38;2;%lu;%lu;%lum"
let &t_8b="\<esc>[48;2;%lu;%lu;%lum"
" :help termcap-cursor-shape
if &term =~ "xterm"
  let &t_SI="\<esc>[5 q" " blinking bar
  let &t_SR="\<esc>[3 q" " blinking underline
  let &t_EI="\<esc>[0 q" " block
endif

" https://github.com/vim/vim/commit/e07e797db0c5ef1aafc650d8bb0d39fb052cf1e1
set ttimeout
set ttimeoutlen=100

augroup gitgutter_listener
  autocmd!
  autocmd User GitGutter let &l:statusline=&l:statusline
augroup END

vnoremap < <gv
vnoremap > >gv
vnoremap * y/<c-r>"<cr>

nnoremap <leader>b :<c-u>ls<cr>:<c-u>b<space>
nnoremap <silent> <leader>m :<c-u>make!<cr>
" TODO: The below ruins last search pattern register
nnoremap <silent> <leader>s mzHmy:<c-u>%s/\s\+$//e<cr>'yz<cr>`z:<c-u>noh<cr>
nnoremap <silent> <leader>q :<c-u>b#<cr>
nnoremap <silent> <leader>= mzHmygg=G'yz<cr>`z

if exists('&colorcolumn')
  set colorcolumn=81
endif

silent! helptags ALL

let g:netrw_home = expand('$HOME/.local/share/vim/')
let g:netrw_fastbrowse = 0
let g:netrw_winsize = 30
let g:netrw_banner = 0

let s:vimrc_host = expand('$HOME/.vimrc.host')
if filereadable(s:vimrc_host) | execute "source " . s:vimrc_host | endif

