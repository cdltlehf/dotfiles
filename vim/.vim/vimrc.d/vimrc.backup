" ~/.vim/vimrc
" It needs Vim 8.0 to use packadd
" Anyway, read https://www.vi-improved.org/recommendations/

" Customize Dracula {{{1

" GitGutter Settings {{{1


" Asyncomplete.vim Settings {{{1
inoremap <expr> <Tab> pumvisible() ? "\<C-n>" : "\<Tab>"
inoremap <expr> <S-Tab> pumvisible() ? "\<C-p>" : "\<S-Tab>"
inoremap <expr> <cr>
      \ pumvisible() ? asyncomplete#close_popup() . "\<cr>" : "\<cr>"
imap <c-space> <Plug>(asyncomplete_force_refresh)

" Comment map {{{1
" TODO: unify these
function! SetPythonCommentMap() abort
  nnoremap <leader>c<space> mcI# <esc>`c
  vnoremap <leader>c<space> :s\/^\/#\

  nnoremap gcc mcI# <esc>`c
  vnoremap gc :s\/^\/#\
endfunction

augroup commentmap
  autocmd!
  autocmd FileType javascript
        \ nnoremap <leader>c<space> mcI// <esc>`c
  autocmd FileType c
        \ nnoremap <leader>c<space> mcI// <esc>`c
  autocmd FileType cpp
        \ nnoremap <leader>c<space> mcI// <esc>`c
augroup END

" Miscellaneous settings {{{1
set number
set relativenumber
" set background=dark
set nowrap
set hlsearch
set hidden
set ignorecase
set smartcase
set tabstop=2 softtabstop=2 shiftwidth=2 expandtab smarttab
set list
let &showbreak = '> '
set belloff=all
set showcmd

cabbr <expr> %% expand('%:p:h')

" nnoremap Q @q
nnoremap Y y$

" nnoremap n nzz
" nnoremap N Nzz

" Leader maps {{{1
" nnoremap <leader>b :b<space><c-d>

" Set text width 80 {{{1
" set textwidth=79

" Pop-up menu {{{1
" set completeopt=noinsert,preview,menuone
" set pumheight=5

" Completion settings "{{{1
augroup completion
  "TODO
  autocmd!
  "autocmd CursorMovedI * execute('if pumvisible() normal! a')
augroup END

" Set backup, spellcheck, swap and undo {{{1
set spell
set undofile

let &backupdir = expand('$HOME/.local/share/vim/backup/')
let &spellfile = expand('$HOME/.local/share/vim/spell/en.utf-8.add')
let &directory = expand('$HOME/.local/share/vim/swap/')
let &undodir = expand('$HOME/.local/share/vim/undo/')

if !isdirectory(&backupdir) | call mkdir(&backupdir, 'p') | endif
let s:spelldir = fnamemodify(&spellfile, ':p:h')
if !isdirectory(s:spelldir) | call mkdir(s:spelldir, 'p') | endif
unlet s:spelldir
if !isdirectory(&directory) | call mkdir(&directory, 'p') | endif
if !isdirectory(&undodir) | call mkdir(&undodir, 'p') | endif

" Set fold (zR/zM to open/close all folds) {{{1
set foldcolumn=1
if v:version < 802
  set fillchars+=vert:│
else
  set fillchars+=vert:│,foldsep:│,foldopen:┌
endif

" Set syntax sync {{{1
syntax sync fromstart

