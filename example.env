# Reference: https://docs.docker.com/compose/how-tos/environment-variables/envvars/

# Active compose profiles (comma-separated: llama, whisper, sd)
COMPOSE_PROFILES=llama

# Optional: Model filenames inside ~/.local/share/models/audio/ and image/
# Defaults: audio.bin, image.gguf
# AUDIO_MODEL=ggml-base.bin
# IMAGE_MODEL=v1-5-pruned-emaonly.safetensors
