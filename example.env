# Reference: https://docs.docker.com/compose/how-tos/environment-variables/envvars/

MODELS_DOWNLOAD="<org>/<chat-repo>:<chat-model>.gguf <org>/<embedding-repo>:<embedding-model>.gguf <org>/<audio-repo>:<audio-model>.bin <org>/<image-repo>:<image-model>.gguf "

CHAT_MODEL=<chat-model>.gguf
EMBEDDING_MODEL=<embedding-model>.gguf
AUDIO_MODEL=<audio-model>.bin
IMAGE_MODEL=<image-model>.gguf

COMPOSE_PROFILES=llama,whisper,sd
