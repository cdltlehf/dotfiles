[build-system]
build-backend = "uv_build"
requires = ["uv_build>=0.13.0,<0.14.0"]

[project]
authors = [
  {open} name = "Your Name", email = "your.email@example.com" {close},
]
dependencies = []
description = "Add your description here"
license = "MIT"
name = "{project|basename}"
readme = "README.md"
requires-python = ">=3.14"
version = "0.1.0"

[tool.ruff]
line-length = 80
preview = true

[tool.ruff.format]
docstring-code-format = true
docstring-code-line-length = 80

[tool.ruff.lint]
ignore = [
  # Conflict with the Ruff formatter:
  # https://docs.astral.sh/ruff/formatter/#conflicting-lint-rules
  "avoidable-escaped-quote",
  "bad-quotes-docstring",
  "bad-quotes-inline-string",
  "bad-quotes-multiline-string",
  "docstring-tab-indentation",
  "indentation-with-invalid-multiple",
  "indentation-with-invalid-multiple-comment",
  "line-too-long",
  "missing-trailing-comma",
  "over-indented",
  "prohibited-trailing-comma",
  "tab-indentation",
  "triple-single-quotes",
  "unnecessary-escaped-quote",
  # Python 3.14 evaluates annotations lazily (PEP 649).
  "future-required-type-annotation",
  "future-rewritable-type-annotation",
  "typing-only-first-party-import",
  "typing-only-standard-library-import",
  "typing-only-third-party-import",
  # Google 3.8.3 allows one-line docstrings without Returns, Yields, or
  # Raises. Revisit when Ruff skips one-line docstrings.
  "docstring-missing-exception",
  "docstring-missing-returns",
  "docstring-missing-yields",
  # Google 3.12 allows TODO comments with a link and avoids naming people.
  # Revisit missing-todo-link when Ruff accepts a link in the parentheses.
  "line-contains-todo",
  "missing-todo-author",
  "missing-todo-link",
  # Google raises exceptions with f-string messages in its examples.
  "f-string-in-exception",
  "raise-vanilla-args",
  "raw-string-in-exception",
  # Google uses print in its examples and does not forbid it.
  "print",
]
select = ["ALL"]

# Google 3.8.2 requires license boilerplate in every file. The SPDX line
# serves as the boilerplate, so no year or author has to be filled in.
[tool.ruff.lint.flake8-copyright]
notice-rgx = "SPDX-License-Identifier: "

[tool.ruff.lint.flake8-tidy-imports]
ban-relative-imports = "all"

[tool.ruff.lint.isort]
force-single-line = true
force-sort-within-sections = true
order-by-type = false
single-line-exclusions = ["collections.abc", "typing", "typing_extensions"]

[tool.ruff.lint.per-file-ignores]
"tests/**/*" = [
  "assert",
  "implicit-namespace-package",
  "magic-value-comparison",
  "private-member-access",
]

[tool.ruff.lint.pydocstyle]
convention = "google"
