# https://github.com/koekeishiya/yabai/blob/master/examples/yabairc

# modal definition
:: default : yabai -m config active_window_border_color 0xffbd93f9; hs -c 'skhd_deactivate()'
:: active @ : yabai -m config active_window_border_color 0xfff1fa8c; hs -c 'skhd_activate()'

default < cmd + ctrl - a; active
active < cmd + ctrl - a; default
active < escape; default

# shortcut
cmd - return : open -a /Applications/iTerm.app
cmd + shift - return : open -a /Applications/Google\ Chrome.app

# focus window
active < o : \
  skhd -k 'escape'; \
  if [ `yabai -m query --windows --window | jq '."zoom-fullscreen"'` = 1 ]; then\
    yabai -m window --toggle zoom-fullscreen; \
  fi; \
  yabai -m window --focus next || yabai -m window --focus first;
active < h : \
  skhd -k 'escape'; \
  if [ `yabai -m query --windows --window | jq '."zoom-fullscreen"'` = 1 ]; then\
    yabai -m window --toggle zoom-fullscreen; \
  fi; \
  yabai -m window --focus west;
active < j : \
  skhd -k 'escape'; \
  if [ `yabai -m query --windows --window | jq '."zoom-fullscreen"'` = 1 ]; then\
    yabai -m window --toggle zoom-fullscreen; \
  fi; \
  yabai -m window --focus south;
active < k : \
  skhd -k 'escape'; \
  if [ `yabai -m query --windows --window | jq '."zoom-fullscreen"'` = 1 ]; then\
    yabai -m window --toggle zoom-fullscreen; \
  fi; \
  yabai -m window --focus north;
active < l : \
  skhd -k 'escape'; \
  if [ `yabai -m query --windows --window | jq '."zoom-fullscreen"'` = 1 ]; then\
    yabai -m window --toggle zoom-fullscreen; \
  fi; \
  yabai -m window --focus east;

# rotate windows
active < shift - o : \
  skhd -k 'escape'; \
  yabai -m window --swap next || yabai -m window --swap first;

# swap window / fill half
active < shift - h : \
  skhd -k 'escape'; \
  if [ `yabai -m query --windows --window | jq .floating` = 0 ]; then\
    yabai -m window --swap west; \
  else \
    yabai -m window --grid 1:2:0:0:1:1; \
  fi;

active < shift - j : \
  skhd -k 'escape'; \
  if [ `yabai -m query --windows --window | jq .floating` = 0 ]; then\
    yabai -m window --swap south; \
  else \
    yabai -m window --grid 4:4:1:1:2:2; \
  fi;

active < shift - k : \
  skhd -k 'escape'; \
  if [ `yabai -m query --windows --window | jq .floating` = 0 ]; then\
    yabai -m window --swap north; \
  else \
    yabai -m window --grid 1:1:0:0:1:1; \
  fi;

active < shift - l : \
  skhd -k 'escape'; \
  if [ `yabai -m query --windows --window | jq .floating` = 0 ]; then\
    yabai -m window --swap east; \
  else \
    yabai -m window --grid 1:2:1:0:1:1; \
  fi;

# balance space
active < 0 : \
    skhd -k 'escape'; \
    yabai -m space --balance; 

# focus space
active < n : \
    skhd -k 'escape'; \
    yabai -m space --focus next;
active < p : \
    skhd -k 'escape'; \
    yabai -m space --focus prev;

# move window to space and focus
active < shift - n : \
    skhd -k 'escape'; \
    yabai -m window --space next; \
    yabai -m space --focus next;

active < shift - p : \
    skhd -k 'escape'; \
    yabai -m window --space prev; \
    yabai -m space --focus prev;

active < c : \
    skhd -k 'escape'; \
    yabai -m space --create; \
    yabai -m space --focus last ;

active < x : \
    skhd -k 'escape'; \
    yabai -m space --destroy recent && yabai -m space --move prev;
    # yabai -m window --close recent || \ TODO: distroy window or space

# zoom/fullscreen
active < z : 
    skhd -k 'escape'; \
    yabai -m window --toggle zoom-fullscreen;

active < f : 
    skhd -k 'escape'; \
    yabai -m window --toggle native-fullscreen;

# toggle split
active < e : \
    skhd -k 'escape'; \
    yabai -m window --toggle split;

# toggle float
active < t : \
    skhd -k 'escape'; \
    yabai -m window --toggle float; \
    yabai -m window --grid 4:4:1:1:2:2;

