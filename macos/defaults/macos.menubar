#!/usr/bin/env zsh
## Custom defaults for menu bar
## See `defaults read NSGlobalDomain

echo 'System Preferences > Dock & Menu Bar'

# https://apple.stackexchange.com/questions/209877/programmatically-auto-hide-menubar-in-el-capitan/210088#210088
echo '... > Automatically hide and show the menubar on desktop (enable)'
# XXX: Not working
# defaults write NSGlobalDomain _HIHideMenuBar -bool true

# Restart Finder
killall Finder
