# ==============================================================================
# Providers (containers/*/compose.yaml)
# ==============================================================================

# Shared API key for gateway, llama-server, mcp-server, pi, and a2a
export COMPOSE_API_KEY="your-secret-api-key"

# mcp-server (containers/mcp-server/compose.yaml)
export COMPOSE_MCP_ALLOWED_HOSTS=""
export COMPOSE_MCP_BASE_URL=""
export COMPOSE_MCP_IMAGE_POSITIVE_PROMPT=""
export COMPOSE_MCP_IMAGE_NEGATIVE_PROMPT=""

# ==============================================================================
# Consumers (host CLI tools & scripts/setup.d/30-agents.sh)
# ==============================================================================

# Host agents (claude, agy, pi) connecting to mcp-server
export AGENT_MCP_URL="http://localhost:8001/mcp"
export AGENT_MCP_API_KEY="${COMPOSE_API_KEY}"

# pi-agent (local LLM client)
export LLAMA_BASE_URL="http://localhost:8000"
export LLAMA_API_KEY="${COMPOSE_API_KEY}"
