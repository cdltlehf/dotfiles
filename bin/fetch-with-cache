#!/bin/sh
#
# Writes the body of a URL to stdout from a cache. The URL is fetched only
# when it is not cached yet, or again when --update is given.

set -o nounset
set -o errexit

update=false
if [ "${1:-}" = "--update" ]; then
  update=true
  shift
fi
url="${1:?usage: fetch-with-cache [--update] URL}"
dir="${XDG_CACHE_HOME:-${HOME}/.cache}/fetch-with-cache"
body="${dir}/$(printf '%s' "${url}" | cksum | cut -d ' ' -f 1)"

if "${update}" || [ ! -e "${body}" ]; then
  mkdir -p "${dir}"
  curl -fsSL -o "${body}.tmp" "${url}"
  mv -f "${body}.tmp" "${body}"
fi
cat "${body}"
