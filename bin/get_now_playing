#! /usr/bin/osascript

set ret to ""
tell application "System Events" to tell its process "ControlCenter"
  try
    set the now_playing to the first menu bar item of menu bar 1 whose description is "Now Playing"
    click now_playing
    set ret to the value of static text of group 1 of its first window
    key code 53
  end try
end tell
return ret
