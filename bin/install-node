#!/bin/bash
(
XDG_DATA_HOME="${XDG_DATA_HOME:-"$HOME/.local/share"}"
NVM_DIR="${NVM_DIR:-"$XDG_DATA_HOME/nvm"}"
mkdir -p "$NVM_DIR"
(
export PROFILE=/dev/null
curl -o- "https://raw.githubusercontent.com/nvm-sh/nvm/v0.39.7/install.sh" \
  | bash
)

(
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
nvm install node
)
)
