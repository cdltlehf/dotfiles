#!/bin/bash -ue

# -u, nounset: Treat unset variables and parameters as an error
# -e, errexit: Exit immediately

# Print a trace of commands
# set -o xtrace # (= `set -x`)

# Get base directory (e.g., `$HOME/dotfiles`)
basedir="$(realpath "$(dirname "$0")")"
# Get kernel name (e.g., Darwin)
kernel="$(uname -s)"

# Update dotfiles
# command -v git > /dev/null && (cd "$basedir" && git pull origin main);

symlink_home() {
  local source_file="$1"

  # If the source file not exists, return with an error
  if [[ ! -e "${source_file}" ]]; then return 1; fi
  local target_file
  target_file="${HOME}/$(basename "$source_file")"

  # If the existing target is a symlink to the source file, return
  if [[ -L "${target_file}" ]] &&
    [[ $(readlink "${target_file}") == "${source_file}" ]]; then
      return 0;
  fi

  # If the target file exists, ask to replace or not
  if [[ -e "${target_file}" ]]; then

    local opt
    echo "File \"${target_file}\" already exists!"
    read -rp \
      "[O]verwrite the file, (B)ackup, (S)kip: " opt
          case ${opt} in
            [Oo] | "" ) rm -rf "${target_file}" ;;
            [Bb] ) mv "${target_file}" "${target_file}.$(date +%s)" ;;
            [Ss] ) return 0 ;;
            * ) return 1 ;;
          esac
  fi

  # Make a target symlink verbosely
  ln -sfn "${source_file}" "${target_file}"
  echo "${target_file} -> ${source_file}"
  return 0
}

# Array of common dotfiles
# TODO: Think about how to deal with ~/.config

# Array of common XDG_CONFIG_HOME dotfiles
dotfiles_common=(
  "${basedir}/bash/.bash_profile"
  "${basedir}/bash/.bashrc"
  "${basedir}/bash/.bashrc.d/"
  "${basedir}/config/.config/"
  "${basedir}/etc/.inputrc"
  "${basedir}/git/.gitconfig"
  "${basedir}/git/.gitmessage.txt"
  "${basedir}/sh/.profile"
  "${basedir}/sh/.shrc"
  "${basedir}/sh/.shrc.d/"
  "${basedir}/tmux/.tmux.conf"
  "${basedir}/tmux/.tmux.conf.d/"
  "${basedir}/vim/.vim/"
  "${basedir}/zsh/.zshrc"
  "${basedir}/zsh/.zshrc.d/"
)

echo "Make symbolic links of common dotfiles..."
for dotfile in "${dotfiles_common[@]}"; do
  symlink_home "${dotfile}" || true
done
unset dotfile

${basedir}/scripts/installers/git_prompt_installer
${basedir}/scripts/installers/node_installer
${basedir}/scripts/installers/vim_installer

echo "Done."

echo "Set configurations for ${kernel}."
kernel_setup_script="${basedir}/setup.d/${kernel}.sh"
[[ -e "${kernel_setup_script}" ]] && source "${kernel_setup_script}"

echo "Restart your login shell with \`exec \"\${SHELL}\" --login\`"

# vim:ft=sh:ts=2:sts=2:sw=2:et:sta
