#!/bin/bash

set -o nounset
set -o errexit
shopt -s nullglob

interactive=0

while [[ $# -gt 0 ]]; do
	case "$1" in
	-h | --help)
		echo "Usage: $(basename "$0") [options]"
		echo "Options:"
		echo "  -h, --help           Show this help message and exit"
		echo "  -i, --interactive    Interactive setup mode (prompt for user details)"
		exit 0
		;;
	--)
		break
		;;
	-i | --interactive)
		interactive=1
		;;
	*)
		echo "Unknown option: $1"
		exit 1
		;;
	esac
	shift
done

echoerr() { echo "$@" 1>&2; }
export -f echoerr

basedir="$(realpath "$(dirname "$0")")"
os="$(uname -s)"

export basedir
export os
export interactive

# shellcheck source=/dev/null
source "${basedir}/env"

symlink() {
	local src="$1" dest="$2"
	[[ $(readlink "$dest" 2>/dev/null) == "$src" ]] && return 0
	[[ -e "$dest" && ! -L "$dest" ]] && mv -f "$dest" "${dest}.bak"
	ln -sfn "$src" "$dest"
}
export -f symlink

# Reference: https://github.com/anishathalye/dotbot (clean directive)
# Safely prune broken symbolic links that point to dotfiles targets
clean_broken_symlinks() {
	local target_dir="$1"
	[ -d "${target_dir}" ] || return 0
	for link in "${target_dir}"/.* "${target_dir}"/*; do
		[ -L "${link}" ] || continue
		[ -e "${link}" ] && continue
		local dest
		dest="$(readlink "${link}" 2>/dev/null || true)"
		case "${dest}" in
		"${basedir}"* | "${XDG_CONFIG_HOME}"* | "${XDG_BIN_HOME:-${HOME}/.local/bin}"*)
			rm -f "${link}"
			;;
		esac
	done
}
export -f clean_broken_symlinks

mkdir -p "${XDG_CONFIG_HOME}"
clean_broken_symlinks "${XDG_CONFIG_HOME}"
for item in "${basedir}/xdg-config-home"/*; do
	symlink "$item" "${XDG_CONFIG_HOME}/$(basename "$item")"
done

symlink "${XDG_CONFIG_HOME}/sh/profile" "${HOME}/.profile"
symlink "${XDG_CONFIG_HOME}/bash/bash_profile" "${HOME}/.bash_profile"
symlink "${XDG_CONFIG_HOME}/bash/bashrc" "${HOME}/.bashrc"
symlink "${XDG_CONFIG_HOME}/zsh/zshenv" "${HOME}/.zshenv"
symlink "${XDG_CONFIG_HOME}/editorconfig/config" "${HOME}/.editorconfig"

LOCAL_GITCONFIG="${HOME}/.gitconfig.local"
if [ ! -f "${LOCAL_GITCONFIG}" ]; then
	if [ "${interactive}" -eq 1 ]; then
		read -r -p "Enter your Git user name: " git_username
		read -r -p "Enter your Git user email: " git_useremail
		cat <<EOF >"${LOCAL_GITCONFIG}"
[user]
  name = ${git_username}
  email = ${git_useremail}
EOF
	else
		cat <<EOF >"${LOCAL_GITCONFIG}"
# Local Git Configuration Override
# [user]
#   name =
#   email =
EOF
	fi
fi

XDG_BIN_HOME="${HOME}/.local/bin"
mkdir -p "${XDG_BIN_HOME}"
clean_broken_symlinks "${XDG_BIN_HOME}"
for script in "${basedir}/xdg-bin-home"/*; do
	[ -e "${script}" ] && symlink "${script}" "${XDG_BIN_HOME}/$(basename "${script}")"
done
export PATH="${XDG_BIN_HOME}:${PATH}"

clean_broken_symlinks "${HOME}"

GIT_COMPLETION_DIR="${XDG_DATA_HOME}/git/completion"
GIT_PROMPT_URL="https://raw.githubusercontent.com/git/git/master/contrib/completion/git-prompt.sh"
mkdir -p "${GIT_COMPLETION_DIR}"
echoerr "'${GIT_PROMPT_URL}' -> '${GIT_COMPLETION_DIR}/git-prompt.sh'"
curl -fsSL "${GIT_PROMPT_URL}" -o "${GIT_COMPLETION_DIR}/git-prompt.sh"
unset GIT_PROMPT_URL
unset GIT_COMPLETION_DIR

WEZTERM_SHELL_INTEGRATION_URL="https://raw.githubusercontent.com/wezterm/wezterm/main/assets/shell-integration/wezterm.sh"
WEZTERM_SHELL_INTEGRATION_DIR="${XDG_DATA_HOME}/wezterm/shell-integration"
mkdir -p "${WEZTERM_SHELL_INTEGRATION_DIR}"
echoerr "'${WEZTERM_SHELL_INTEGRATION_URL}' -> '${WEZTERM_SHELL_INTEGRATION_DIR}/wezterm.sh'"
curl -fsSL "${WEZTERM_SHELL_INTEGRATION_URL}" -o "${WEZTERM_SHELL_INTEGRATION_DIR}/wezterm.sh"
unset WEZTERM_SHELL_INTEGRATION_URL
unset WEZTERM_SHELL_INTEGRATION_DIR

if ! command -v mise &>/dev/null; then
	curl "https://mise.run" | sh
fi
mise install --yes || echoerr "Warning: Some mise tools failed to install"

os_setup="${basedir}/setup.os/setup#os.${os}"
[[ -f "${os_setup}" ]] && "${os_setup}"

echo "Restart your login shell with \`exec \"\${SHELL}\" --login\`"
