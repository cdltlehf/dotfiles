#!/bin/bash

set nounset
set errexit
shopt -s nullglob

# Get base directory (e.g., `$HOME/dotfiles`)
basedir="$(realpath "$(dirname "$0")")"
# Get OS name (e.g., Darwin)
os="$(uname -s)"

source "$basedir/env"

echoerr() { echo "$@" 1>&2; }
export -f echoerr

symlink_interactive() {
  local source_file="$1"
  # If the source file not exists, return with an error
  if [[ ! -e "${source_file}" ]]; then return 1; fi

  local target_file
  target_file="$2"

  # If the existing target is a symlink to the source file, return
  if [[ -L "${target_file}" ]] &&
    [ "$(readlink "${target_file}")" = "${source_file}" ]; then
      return 0;
  fi

  # If the target file exists, ask to replace or not
  if [[ -e "${target_file}" ]]; then

    local opt
    echo "File \"${target_file}\" already exists!"
    read -rp \
      "[O]verwrite the file, (B)ackup, (S)kip: " opt
          case ${opt} in
            [Oo] | "" ) rm -rf "${target_file}" ;;
            [Bb] ) mv "${target_file}" "${target_file}.$(date +%s)" ;;
            [Ss] ) return 0 ;;
            * ) return 1 ;;
          esac
  fi

  # Make a target symlink verbosely
  mkdir -p "$(dirname "${target_file}")"
  ln -sfn "${source_file}" "${target_file}"
  echoerr "${target_file} -> ${source_file}"
  return 0
}
export -f symlink_interactive

symlink_interactive "${basedir}/env" "${HOME}/.shenv"

for file in "${basedir}"/home/*; do
  basename="$(basename "${file}" | sed 's/^_/./')"
  target="${HOME}/${basename}"
  symlink_interactive "${file}" "${target}"
done


: "${XDG_CONFIG_HOME:="${HOME}/.config"}"
mkdir -p "${XDG_CONFIG_HOME}"
for file in "${basedir}"/xdg_config_home/*/*; do
  basename="$(basename "${file}" | sed 's/^_/./')"
  dirname="$(dirname "${file}")"
  dirname="${XDG_CONFIG_HOME}/${dirname#"${basedir}"/xdg_config_home/}"
  target="${dirname}/${basename}"
  symlink_interactive "${file}" "${target}"
done

: "${XDG_BIN_HOME:="${HOME}/.local/bin"}"
mkdir -p "${XDG_BIN_HOME}"
for executable in "${basedir}"/xdg_bin_home/*; do
  basename="$(basename "${executable}")"
  target="${XDG_BIN_HOME}/${basename}"
  symlink_interactive "${executable}" "${target}"
done

os_setup="${basedir}/setup.os/setup##os.${os}"
if [[ -e "${os_setup}" ]]; then
  read -r -p "Do you want to set configurations for ${os}? [Y/n] " yn
  case $yn in
    [Yy] | "" )
      echoerr "Run ${os_setup}"
      "${os_setup}"
    ;;
    [Nn] ) ;;
    * ) exit 1;;
  esac
fi

echo "Restart your login shell with \`exec \"\${SHELL}\" --login\`"
