#!/bin/bash

set nounset
set errexit
shopt -s nullglob

echoerr() { echo "$@" 1>&2; }
export -f echoerr

interactive_link() {
  local file=$1
  local target=$2
  if [[ -L ${target} ]] && [[ $(readlink "${target}") == "${file}" ]]; then
    echoerr "${target} is already linked to ${file}"
    return
  fi
  if [[ -e ${target} ]]; then
    read -r -p "Do you want to overwrite ${target}? [Y/n] " yn
    case $yn in
      [Yy] | "" ) rm -rf "${target}" ;;
      [Nn] ) ;;
      * ) exit 1;;
    esac
  fi
  ln -fs "${file}" "${target}"
  echoerr "Linking ${target} -> ${file}"
}

# Get base directory (e.g., `$HOME/dotfiles`)
basedir="$(realpath "$(dirname "$0")")"
# Get OS name (e.g., Darwin)
os="$(uname -s)"

export basedir
export os

# shellcheck source=/dev/null
source "${basedir}/env"
interactive_link "${basedir}/env" "${HOME}/.shenv"

interactive_link "${basedir}/xdg_config_home" "${HOME}/.config"
interactive_link "${basedir}/xdg_config_home/bash/bash_profile" "${HOME}/.bash_profile"
interactive_link "${basedir}/xdg_config_home/bash/bashrc" "${HOME}/.bashrc"
interactive_link "${basedir}/xdg_config_home/git/gitmessage" "${HOME}/.gitmessage"
interactive_link "${basedir}/xdg_config_home/sh/profile" "${HOME}/.profile"
interactive_link "${basedir}/xdg_config_home/tmux/tmux.conf" "${HOME}/.tmux.conf"
interactive_link "${basedir}/xdg_config_home/vim/vimrc" "${HOME}/.vimrc"
interactive_link "${basedir}/xdg_config_home/zsh/zshenv" "${HOME}/.zshenv"
touch "${HOME}/.hushlogin"

interactive_link "${basedir}/xdg_config_home/zsh/zprofile" "${XDG_CONFIG_HOME}/zsh/.zprofile"
interactive_link "${basedir}/xdg_config_home/zsh/zshrc" "${XDG_CONFIG_HOME}/zsh/.zshrc"

os_setup="${basedir}/setup.os/setup##os.${os}"
if [[ -e "${os_setup}" ]]; then
  read -r -p "Do you want to set configurations for ${os}? [Y/n] " yn
  case $yn in
    [Yy] | "" )
      echoerr "Run ${os_setup}"
      "${os_setup}"
    ;;
    [Nn] ) ;;
    * ) exit 1;;
  esac
fi

echo "Restart your login shell with \`exec \"\${SHELL}\" --login\`"
