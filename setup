#!/bin/bash

set -o nounset
set -o errexit
shopt -s nullglob

force=0

while [[ $# -gt 0 ]]; do
	case "$1" in
	-h | --help)
		echo "Usage: $(basename $0) [options]"
		echo "Options:"
		echo "  -h, --help    Show this help message and exit"
		echo "  -f, --force   Force overwrite existing files"
		exit 0
		;;
	--)
		break
		;;
	-f | --force)
		force=1
		;;
	*)
		echo "Unknown option: $1"
		exit 1
		;;
	esac
	shift
done

echoerr() { echo "$@" 1>&2; }
export -f echoerr

if [[ $force -eq 1 ]]; then
	LNFLAGS="-svnf"
	RMFLAGS="-rvf"
else
	LNFLAGS="-svni"
	RMFLAGS="-rvi"
fi

# Get base directory (e.g., `$HOME/dotfiles`)
basedir="$(realpath "$(dirname "$0")")"
# Get OS name (e.g., Darwin)
os="$(uname -s)"

export LNFLAGS
export RMFLAGS
export basedir
export os
export force

# shellcheck source=/dev/null
source "${basedir}/env"

symlink() {
	local src="$1"
	local dest="$2"

	if [ -L "$dest" ]; then
		local link_target
		link_target=$(readlink "$dest")
		if [ "$link_target" = "$src" ]; then
			return 0
		fi
	fi

	if [ -d "$dest" ] || [ -h "$dest" ]; then
		if [[ $force -eq 1 ]]; then
			rm ${RMFLAGS} "$dest"
			ln ${LNFLAGS} "$src" "$dest"
		else
			echo "Warning: Target directory '$dest' already exists. Use -f to overwrite."
		fi
	else
		ln ${LNFLAGS} "$src" "$dest"
	fi
}

mkdir -p "${XDG_CONFIG_HOME}"
for item in "${basedir}/xdg-config-home"/*; do
	symlink "$item" "${XDG_CONFIG_HOME}/$(basename "$item")"
done

symlink "${basedir}/xdg-config-home/bash/bash_profile" "${HOME}/.bash_profile"
symlink "${basedir}/xdg-config-home/bash/bashrc" "${HOME}/.bashrc"
symlink "${basedir}/xdg-config-home/git/gitmessage" "${HOME}/.gitmessage"
symlink "${basedir}/xdg-config-home/sh/profile" "${HOME}/.profile"
symlink "${basedir}/xdg-config-home/tmux/tmux.conf" "${HOME}/.tmux.conf"
symlink "${basedir}/xdg-config-home/vim/vimrc" "${HOME}/.vimrc"
symlink "${basedir}/xdg-config-home/zsh/zprofile" "${XDG_CONFIG_HOME}/zsh/.zprofile"
symlink "${basedir}/xdg-config-home/zsh/zshenv" "${HOME}/.zshenv"
symlink "${basedir}/xdg-config-home/zsh/zshrc" "${XDG_CONFIG_HOME}/zsh/.zshrc"

LOCAL_GITCONFIG="${HOME}/.gitconfig.local"
if [ ! -f "${LOCAL_GITCONFIG}" ]; then
	read -r -p "Do you want to create a local gitconfig file at ${LOCAL_GITCONFIG}? [Y/n] " yn
	case ${yn} in
	[Yy] | "")
		read -r -p "Enter your git user name: " git_username
		read -r -p "Enter your git user email: " git_useremail
		cat <<EOF >"${LOCAL_GITCONFIG}"
[user]
  name = ${git_username}
  email = ${git_useremail}
EOF
		;;
	esac
fi

XDG_BIN_HOME="${HOME}/.local/bin"
mkdir -p "${XDG_BIN_HOME}"
ln ${LNFLAGS} "${basedir}/scripts"/* ${XDG_BIN_HOME}

GIT_COMPLETION_DIR="${XDG_DATA_HOME}/git/completion"
GIT_PROMPT_URL="https://raw.githubusercontent.com/git/git/master/contrib/completion/git-prompt.sh"
mkdir -p "${GIT_COMPLETION_DIR}"
echoerr "'${GIT_PROMPT_URL}' -> '${GIT_COMPLETION_DIR}/git-prompt.sh'"
curl -sS -L "${GIT_PROMPT_URL}" -o "${GIT_COMPLETION_DIR}/git-prompt.sh"
unset GIT_PROMPT_URL
unset GIT_COMPLETION_DIR

WEZTERM_SHELL_INTEGRATION_URL="https://raw.githubusercontent.com/wezterm/wezterm/main/assets/shell-integration/wezterm.sh"
WEZTERM_SHELL_INTEGRATION_DIR="${XDG_DATA_HOME}/wezterm/shell-integration"
mkdir -p "${WEZTERM_SHELL_INTEGRATION_DIR}"
echoerr "'${WEZTERM_SHELL_INTEGRATION_URL}' -> '${WEZTERM_SHELL_INTEGRATION_DIR}/wezterm.sh'"
curl -sS -L "${WEZTERM_SHELL_INTEGRATION_URL}" -o "${WEZTERM_SHELL_INTEGRATION_DIR}/wezterm.sh"
unset WEZTERM_SHELL_INTEGRATION_URL
unset WEZTERM_SHELL_INTEGRATION_DIR

if ! command mise -v 2>/dev/null; then
	curl "https://mise.run" | sh
	eval "$("${HOME}/.local/bin/mise" activate bash)"
fi

echoerr "Run \`mise install\` to install tools"

os_setup="${basedir}/setup.os/setup#os.${os}"
if [[ -f "${os_setup}" ]]; then
	read -r -p "Do you want to set configurations for ${os}? [Y/n] " yn
	case ${yn} in
	[Yy] | "") "${os_setup}" ;;
	esac
fi

echo "Restart your login shell with \`exec \"\${SHELL}\" --login\`"
