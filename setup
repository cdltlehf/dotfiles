#!/bin/bash

set nounset
set errexit
shopt -s nullglob

# Print a trace of commands
# set -o xtrace # (= `set -x`)

XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-$HOME/.config}
# Get base directory (e.g., `$HOME/dotfiles`)
basedir="$(realpath "$(dirname "$0")")"
# Get OS name (e.g., Darwin)
os="$(uname -s)"

# Update dotfiles
# command -v git > /dev/null && (cd "$basedir" && git pull origin main);

echoerr() { echo "$@" 1>&2; }
export -f echoerr

symlink_interactive() {
  local source_file="$1"
  # If the source file not exists, return with an error
  if [[ ! -e "${source_file}" ]]; then return 1; fi

  local target_file
  target_file="$2"

  # If the existing target is a symlink to the source file, return
  if [[ -L "${target_file}" ]] &&
    [[ $(readlink "${target_file}") == "${source_file}" ]]; then
      return 0;
  fi

  # If the target file exists, ask to replace or not
  if [[ -e "${target_file}" ]]; then

    local opt
    echo "File \"${target_file}\" already exists!"
    read -rp \
      "[O]verwrite the file, (B)ackup, (S)kip: " opt
          case ${opt} in
            [Oo] | "" ) rm -rf "${target_file}" ;;
            [Bb] ) mv "${target_file}" "${target_file}.$(date +%s)" ;;
            [Ss] ) return 0 ;;
            * ) return 1 ;;
          esac
  fi

  # Make a target symlink verbosely
  mkdir -p "$(dirname "${target_file}")"
  ln -sfn "${source_file}" "${target_file}"
  echoerr "${target_file} -> ${source_file}"
  return 0
}
export -f symlink_interactive

# Array of common dotfiles
dotfiles_common=(
  "${basedir}/bash/.bash_profile"
  "${basedir}/bash/.bashrc"
  "${basedir}/bash/.bashrc.d/"
  "${basedir}/etc/.inputrc"
  "${basedir}/sh/.profile"
  "${basedir}/sh/.shrc"
  "${basedir}/sh/.shrc.d/"
  "${basedir}/vim/.vim/"
  "${basedir}/zsh/.zshrc"
  "${basedir}/zsh/.zshrc.d/"
)

echoerr "Make symbolic links of common dotfiles..."
for dotfile in "${dotfiles_common[@]}"; do
  symlink_interactive "${dotfile}" "${HOME}/$(basename "${dotfile}")"
done
echoerr "Done."

for file in "${basedir}"/setup.d/*.bash; do
  echoerr "Run $file"
  bash "$file"
done

mkdir -p "${XDG_CONFIG_HOME}"
for source_file in "${basedir}"/xdg_config_home/**/*; do
  target_file="${XDG_CONFIG_HOME}/${source_file#"${basedir}"/xdg_config_home/}"
  symlink_interactive "${source_file}" "${target_file}"
done

os_setup="${basedir}/setup.os/setup##os.${os}"
if [[ -e "${os_setup}" ]]; then
  read -r -p "Do you want to set configurations for ${os}? [Y/n] " yn
  case $yn in
    [Yy] | "" )
      echoerr "Run ${os_setup}"
      "${os_setup}"
    ;;
    [Nn] ) ;;
    * ) exit 1;;
  esac
fi

echo "Restart your login shell with \`exec \"\${SHELL}\" --login\`"
