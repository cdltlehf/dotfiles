[alias]
  ; https://git-scm.com/book/en/v2/Git-Basics-Git-Aliases
  co = checkout
  br = branch
  ci = commit
  st = status
  unstage = reset HEAD --
  last = log -1 HEAD
  ; misc
  cim = commit -m
  root = rev-parse --show-toplevel

[color]
  ui = auto
  diff = auto
  status = auto
  branch = auto
  interactive = auto
  grep = auto

[core]
  editor = vim
  pager = less -F

[include]
  path = .gitconfig.local

[submodule]
  recurse = true

[commit]
  template = ~/.gitmessage.txt
