#!/usr/bin/env bash
#TODO: Add git-feature
PROMPT_COMMAND=__prompt_command

__prompt_command() {
  local EXIT="$?"

  PS1=$'\n'
  PS1+=$"\[\033[1;35m\]\u\[\033[0m\] at "
  PS1+=$"\[\033[1;33m\]\h\[\033[0m\] in "
  PS1+=$"\[\033[1;32m\]\w\[\033[0m\]"
  PS1+=$'\n'
  if [ $EXIT == 0 ]; then
    PS1+=$"$ "
  else
    PS1+=$"\[\033[1;31m\]?$EXIT \[\033[0m\]"
  fi

  PS2=$"\[\033[38;5;103m\]> \[\033[0m\]" # 256-color
}

