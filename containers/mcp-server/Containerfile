FROM docker.io/library/python:alpine AS builder

RUN pip install --no-cache-dir --prefix=/install "mcp[cli]" httpx

FROM docker.io/library/python:alpine

COPY --from=builder /install /usr/local
COPY server.py /app/server.py

WORKDIR /app

ENV HOST=0.0.0.0

EXPOSE 8080
ENTRYPOINT ["python", "-u", "/app/server.py"]
