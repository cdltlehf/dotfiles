#!/bin/sh
# git-prompt-codicon: Fast Git status prompt using git-prompt-codicon.awk

# Exit immediately if required commands or git work tree are not available
command -v git >/dev/null 2>&1 || exit 0
command -v awk >/dev/null 2>&1 || exit 0
git_dir="$(git rev-parse --git-dir 2>/dev/null)" || exit 0

# Resolve script directory for symlink compatibility
if command -v realpath >/dev/null 2>&1; then
    script_dir="$(dirname "$(realpath "$0")")"
else
    script_dir="$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd -P)"
fi

awk_script="${script_dir}/git-prompt-codicon.awk"
[ -f "${awk_script}" ] || exit 0

glyphs="${LC_TERMINAL_GLYPHS:-ascii}"

# Detect in-progress git operations
operation=""
rebase_branch=""

if [ -d "${git_dir}/rebase-merge" ]; then
    step="$(cat "${git_dir}/rebase-merge/msgnum" 2>/dev/null)"
    total="$(cat "${git_dir}/rebase-merge/end" 2>/dev/null)"
    head_name="$(cat "${git_dir}/rebase-merge/head-name" 2>/dev/null)"
    rebase_branch="${head_name#refs/heads/}"
    if [ -f "${git_dir}/rebase-merge/interactive" ]; then
        operation="|REBASE-i ${step}/${total}"
    else
        operation="|REBASE-m ${step}/${total}"
    fi
elif [ -d "${git_dir}/rebase-apply" ]; then
    head_name="$(cat "${git_dir}/rebase-apply/head-name" 2>/dev/null)"
    rebase_branch="${head_name#refs/heads/}"
    if [ -f "${git_dir}/rebase-apply/rebasing" ]; then
        step="$(cat "${git_dir}/rebase-apply/next" 2>/dev/null)"
        total="$(cat "${git_dir}/rebase-apply/last" 2>/dev/null)"
        operation="|REBASE ${step}/${total}"
    elif [ -f "${git_dir}/rebase-apply/applying" ]; then
        operation="|AM"
    else
        operation="|AM/REBASE"
    fi
elif [ -f "${git_dir}/MERGE_HEAD" ]; then
    operation="|MERGING"
elif [ -f "${git_dir}/CHERRY_PICK_HEAD" ]; then
    operation="|CHERRY-PICKING"
elif [ -f "${git_dir}/REVERT_HEAD" ]; then
    operation="|REVERTING"
elif [ -f "${git_dir}/BISECT_LOG" ]; then
    operation="|BISECTING"
fi

# Detect tag if HEAD is detached
tag_name=""
if [ -f "${git_dir}/HEAD" ]; then
    head_content="$(cat "${git_dir}/HEAD" 2>/dev/null)"
    case "${head_content}" in
        ref:*) ;;
        *)
            tag_name="$(git describe --tags --exact-match 2>/dev/null)"
            ;;
    esac
fi

# Execute git status and parse via awk module
git status --porcelain=v2 --branch 2>/dev/null | awk \
    -v charset="${glyphs}" \
    -v op="${operation}" \
    -v op_branch="${rebase_branch}" \
    -v tag_name="${tag_name}" \
    -f "${awk_script}"
