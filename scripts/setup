#!/bin/sh
#
# Reference: https://github.com/git/git
# Reference: https://wezfurlong.org/wezterm/
# Reference: https://iterm2.com/
# Reference: https://github.com/ThomasDickey/xterm-snapshots
# Reference: https://github.com/robertknight/konsole
# Reference: https://github.com/ryanoasis/nerd-fonts
# Reference: https://mise.jdx.dev/
# Reference: https://adr.github.io/madr/

set -o nounset
set -o errexit

BASE_DIR="$(cd "$(dirname "$0")/.." && pwd)"
readonly BASE_DIR

# shellcheck source=scripts/lib.sh
. "${BASE_DIR}/scripts/lib.sh"

export __DOTFILES_SETUP=1

readonly BIN_DIR="${HOME}/.local/bin"
__pathmunge "${BIN_DIR}"

: "${XDG_CACHE_HOME:="${HOME}/.cache"}"
: "${XDG_CONFIG_HOME:="${HOME}/.config"}"
: "${XDG_DATA_HOME:="${HOME}/.local/share"}"
: "${XDG_STATE_HOME:="${HOME}/.local/state"}"
export XDG_CACHE_HOME XDG_CONFIG_HOME XDG_DATA_HOME XDG_STATE_HOME

: "${CARGO_HOME:="${XDG_DATA_HOME}/cargo"}"
: "${RUSTUP_HOME:="${XDG_DATA_HOME}/rustup"}"
export CARGO_HOME RUSTUP_HOME

readonly BOLD_ITALICS_URL="https://raw.githubusercontent.com/ThomasDickey/xterm-snapshots/master/vttests/bold-italics.pl"
readonly COLOR_256_URL="https://raw.githubusercontent.com/ThomasDickey/xterm-snapshots/master/vttests/256colors2.pl"
readonly COLOR_SPACES_URL="https://raw.githubusercontent.com/robertknight/konsole/master/tests/color-spaces.pl"
readonly GIT_COMPLETION_DIR="${XDG_DATA_HOME}/git/completion"
readonly GIT_PROMPT_URL="https://raw.githubusercontent.com/git/git/master/contrib/completion/git-prompt.sh"
readonly IMGCAT_URL="https://iterm2.com/utilities/imgcat"
readonly IMGLS_URL="https://iterm2.com/utilities/imgls"
readonly MADR_TEMPLATE_URL="https://raw.githubusercontent.com/adr/madr/4.0.0/template"
readonly MISE_INSTALL_URL="https://mise.run"
readonly OTHER_SGR_URL="https://raw.githubusercontent.com/ThomasDickey/xterm-snapshots/master/vttests/other-sgr.sh"
readonly QUERY_COLOR_URL="https://raw.githubusercontent.com/ThomasDickey/xterm-snapshots/master/vttests/query-color.pl"
readonly QUERY_DYNAMIC_URL="https://raw.githubusercontent.com/ThomasDickey/xterm-snapshots/master/vttests/query-dynamic.pl"
readonly QUERY_FONTS_URL="https://raw.githubusercontent.com/ThomasDickey/xterm-snapshots/master/vttests/query-fonts.pl"
readonly TEST_FONTS_URL="https://raw.githubusercontent.com/ryanoasis/nerd-fonts/master/bin/scripts/test-fonts.sh"
readonly WEZTERM_SHELL_INTEGRATION_DIR="${XDG_DATA_HOME}/wezterm/shell-integration"
readonly WEZTERM_SHELL_INTEGRATION_URL="https://raw.githubusercontent.com/wezterm/wezterm/main/assets/shell-integration/wezterm.sh"
readonly ZSH_COMPLETION_DIR="${XDG_DATA_HOME}/zsh/site-functions"

OS="$(detect_os)"
ARCH="$(detect_arch)"
export OS ARCH
readonly OS ARCH
mkdir -p "${XDG_DATA_HOME}"
mkdir -p "${XDG_CONFIG_HOME}"
mkdir -p "${XDG_STATE_HOME}"
mkdir -p "${XDG_CACHE_HOME}"
mkdir -p "${BIN_DIR}"
mkdir -p "${XDG_DATA_HOME}/models/responses"
mkdir -p "${XDG_DATA_HOME}/models/embeddings"
mkdir -p "${XDG_DATA_HOME}/models/audio"
mkdir -p "${XDG_DATA_HOME}/models/images"

run_hook pre-setup

for item in "${BASE_DIR}/xdg-config-home"/*; do
  [ -e "${item}" ] || continue
  symlink "${item}" "${XDG_CONFIG_HOME}/$(basename "${item}")"
done
unset item

# shellcheck source=/dev/null
[ -f "${XDG_CONFIG_HOME}/user-dirs.dirs" ] && . "${XDG_CONFIG_HOME}/user-dirs.dirs"
: "${XDG_TEMPLATES_DIR:="${HOME}/Templates"}"
export XDG_TEMPLATES_DIR

# These shells read only fixed paths in $HOME.
# Revisit each link when its shell reads XDG_CONFIG_HOME.
symlink "${XDG_CONFIG_HOME}/sh/dot_profile" "${HOME}/.profile"
symlink "${XDG_CONFIG_HOME}/bash/dot_bash_profile" "${HOME}/.bash_profile"
symlink "${XDG_CONFIG_HOME}/bash/dot_bashrc" "${HOME}/.bashrc"
symlink "${XDG_CONFIG_HOME}/zsh/dot_zshenv" "${HOME}/.zshenv"
# The existence of "${XDG_CONFIG_HOME}/zsh/.z{shrc,zprofile}" is guaranteed by the above symlink command.
symlink "dot_zprofile" "${XDG_CONFIG_HOME}/zsh/.zprofile"
symlink "dot_zshrc" "${XDG_CONFIG_HOME}/zsh/.zshrc"

for script in "${BASE_DIR}/bin"/*; do
  [ -e "${script}" ] || continue
  symlink "${script}" "${BIN_DIR}/$(basename "${script}")"
done
unset script

download "${BOLD_ITALICS_URL}" "${BIN_DIR}/bold-italics" "+x"
download "${COLOR_256_URL}" "${BIN_DIR}/256colors2" "+x"
download "${COLOR_SPACES_URL}" "${BIN_DIR}/color-spaces" "+x"
download "${GIT_PROMPT_URL}" "${GIT_COMPLETION_DIR}/git-prompt.sh"
download "${IMGCAT_URL}" "${BIN_DIR}/imgcat" "+x"
download "${IMGLS_URL}" "${BIN_DIR}/imgls" "+x"
download "${OTHER_SGR_URL}" "${BIN_DIR}/other-sgr" "+x"
download "${QUERY_COLOR_URL}" "${BIN_DIR}/query-color" "+x"
download "${QUERY_DYNAMIC_URL}" "${BIN_DIR}/query-dynamic" "+x"
download "${QUERY_FONTS_URL}" "${BIN_DIR}/query-fonts" "+x"
download "${TEST_FONTS_URL}" "${BIN_DIR}/test-fonts" "+x"
download "${WEZTERM_SHELL_INTEGRATION_URL}" \
  "${WEZTERM_SHELL_INTEGRATION_DIR}/wezterm.sh"

readonly MADR_FILES=".markdownlint.yml \
  0000-use-markdown-architectural-decision-records.md \
  adr-template-bare-minimal.md \
  adr-template-bare.md \
  adr-template-minimal.md \
  adr-template.md"

for file in ${MADR_FILES}; do
  download "${MADR_TEMPLATE_URL}/${file}" "${BASE_DIR}/xdg-templates-dir/madr/docs/decisions/${file}"
done
unset file
symlink "adr-template-minimal.md" "${BASE_DIR}/xdg-templates-dir/madr/docs/decisions/{}.md"
symlink "{}.h.tmpl" "${BASE_DIR}/xdg-templates-dir/c/include/{}.hpp.tmpl"

[ -L "${XDG_TEMPLATES_DIR}" ] && rm "${XDG_TEMPLATES_DIR}"
mkdir -p "${XDG_TEMPLATES_DIR}"
for item in "${BASE_DIR}/xdg-templates-dir"/*; do
  [ -e "${item}" ] || continue
  name="$(basename "${item}")"
  case "${name}" in
  dot_*) name=".${name#dot_}" ;;
  *) ;;
  esac
  symlink "${item}" "${XDG_TEMPLATES_DIR}/${name}"
done
unset item name

# Agents read their global instructions only from fixed paths in $HOME.
# Link them to one tracked file, so that a tool writing into them shows up
# in `git diff`. Moving the whole directory with a variable such as
# CODEX_HOME would also move data, state, and cache into XDG_CONFIG_HOME.
# Revisit each link when its agent separates configuration from data.
if command -v claude >/dev/null; then
  symlink "${XDG_CONFIG_HOME}/agents/AGENTS.md" "${HOME}/.claude/CLAUDE.md"
fi

if command -v agy >/dev/null; then
  symlink "${XDG_CONFIG_HOME}/agents/AGENTS.md" "${HOME}/.gemini/GEMINI.md"
  symlink "${XDG_CONFIG_HOME}/agents/AGENTS.md" "${HOME}/.gemini/config/AGENTS.md"
fi

if command -v codex >/dev/null; then
  symlink "${XDG_CONFIG_HOME}/agents/AGENTS.md" "${CODEX_HOME:-${HOME}/.codex}/AGENTS.md"
fi

if command -v pi >/dev/null; then
  mkdir -p "${HOME}/.pi/agent"
  symlink "${XDG_CONFIG_HOME}/pi/agent/settings.json" "${HOME}/.pi/agent/settings.json"
  symlink "${XDG_CONFIG_HOME}/agents/AGENTS.md" "${HOME}/.pi/agent/AGENTS.md"
fi

if ! command -v mise >/dev/null; then
  tmpdir="$(mktemp -d)"
  if [ -n "${tmpdir}" ] && [ -d "${tmpdir}" ]; then
    download "${MISE_INSTALL_URL}" "${tmpdir}/install.sh"
    sh "${tmpdir}/install.sh" 2>/dev/null || true
    rm -rf "${tmpdir}"
  fi
  unset tmpdir
fi

zsh_completion() {
  _name="$1"
  shift
  if mise exec -- "$@" >"${ZSH_COMPLETION_DIR}/_${_name}.tmp" 2>/dev/null; then
    mv "${ZSH_COMPLETION_DIR}/_${_name}.tmp" "${ZSH_COMPLETION_DIR}/_${_name}"
  fi
  rm -f "${ZSH_COMPLETION_DIR}/_${_name}.tmp"
  unset _name
}

if command -v mise >/dev/null; then
  mise install --yes || true
  mkdir -p "${ZSH_COMPLETION_DIR}"
  zsh_completion bat bat --completion zsh
  zsh_completion bun bun completions
  zsh_completion cargo rustup completions zsh cargo
  zsh_completion deno deno completions zsh
  zsh_completion fd fd --gen-completions zsh
  zsh_completion gh gh completion -s zsh
  zsh_completion rg rg --generate complete-zsh
  zsh_completion ruff ruff generate-shell-completion zsh
  zsh_completion rustup rustup completions zsh rustup
  zsh_completion taplo taplo completions zsh
  zsh_completion uv uv generate-shell-completion zsh
  zsh_completion uvx uvx --generate-shell-completion zsh
fi

run_hook post-setup
