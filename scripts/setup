#!/bin/sh
#
# Reference: https://github.com/git/git
# Reference: https://wezfurlong.org/wezterm
# Reference: https://iterm2.com
# Reference: https://github.com/ThomasDickey/xterm-snapshots
# Reference: https://github.com/robertknight/konsole
# Reference: https://github.com/ryanoasis/nerd-fonts
# Reference: https://mise.jdx.dev

set -o nounset
set -o errexit

BASE_DIR="$(cd "$(dirname "$0")/.." && pwd)"
readonly BASE_DIR

# shellcheck source=scripts/lib.sh
. "${BASE_DIR}/scripts/lib.sh"

export __DOTFILES_SETUP=1

readonly BIN_DIR="${HOME}/.local/bin"
__pathmunge "${BIN_DIR}"

: "${XDG_CACHE_HOME:="${HOME}/.cache"}"
: "${XDG_CONFIG_HOME:="${HOME}/.config"}"
: "${XDG_DATA_HOME:="${HOME}/.local/share"}"
: "${XDG_STATE_HOME:="${HOME}/.local/state"}"
export XDG_CACHE_HOME XDG_CONFIG_HOME XDG_DATA_HOME XDG_STATE_HOME

readonly BOLD_ITALICS_URL="https://raw.githubusercontent.com/ThomasDickey/xterm-snapshots/master/vttests/bold-italics.pl"
readonly COLOR_256_URL="https://raw.githubusercontent.com/ThomasDickey/xterm-snapshots/master/vttests/256colors2.pl"
readonly COLOR_SPACES_URL="https://raw.githubusercontent.com/robertknight/konsole/master/tests/color-spaces.pl"
readonly GIT_COMPLETION_DIR="${XDG_DATA_HOME}/git/completion"
readonly GIT_PROMPT_URL="https://raw.githubusercontent.com/git/git/master/contrib/completion/git-prompt.sh"
readonly IMGCAT_URL="https://iterm2.com/utilities/imgcat"
readonly IMGLS_URL="https://iterm2.com/utilities/imgls"
readonly LOCAL_GITCONFIG="${HOME}/.gitconfig.local"
readonly MISE_INSTALL_URL="https://mise.run"
readonly OTHER_SGR_URL="https://raw.githubusercontent.com/ThomasDickey/xterm-snapshots/master/vttests/other-sgr.sh"
readonly QUERY_COLOR_URL="https://raw.githubusercontent.com/ThomasDickey/xterm-snapshots/master/vttests/query-color.pl"
readonly QUERY_DYNAMIC_URL="https://raw.githubusercontent.com/ThomasDickey/xterm-snapshots/master/vttests/query-dynamic.pl"
readonly QUERY_FONTS_URL="https://raw.githubusercontent.com/ThomasDickey/xterm-snapshots/master/vttests/query-fonts.pl"
readonly TEST_FONTS_URL="https://raw.githubusercontent.com/ryanoasis/nerd-fonts/master/bin/scripts/test-fonts.sh"
readonly WEZTERM_SHELL_INTEGRATION_DIR="${XDG_DATA_HOME}/wezterm/shell-integration"
readonly WEZTERM_SHELL_INTEGRATION_URL="https://raw.githubusercontent.com/wezterm/wezterm/main/assets/shell-integration/wezterm.sh"

OS="$(detect_os)"
ARCH="$(detect_arch)"
export OS ARCH
readonly OS ARCH
mkdir -p "${XDG_DATA_HOME}"
mkdir -p "${XDG_CONFIG_HOME}"
mkdir -p "${XDG_STATE_HOME}"
mkdir -p "${XDG_CACHE_HOME}"
mkdir -p "${BIN_DIR}"

run_hook pre-setup

for item in "${BASE_DIR}/xdg-config-home"/*; do
  [ -e "${item}" ] || continue
  symlink "${item}" "${XDG_CONFIG_HOME}/$(basename "${item}")"
done
unset item

symlink "${XDG_CONFIG_HOME}/sh/profile" "${HOME}/.profile"
symlink "${XDG_CONFIG_HOME}/bash/bash_profile" "${HOME}/.bash_profile"
symlink "${XDG_CONFIG_HOME}/bash/bashrc" "${HOME}/.bashrc"
symlink "${XDG_CONFIG_HOME}/zsh/zshenv" "${HOME}/.zshenv"
# The existence of "${XDG_CONFIG_HOME}/zsh/.z{shrc,zprofile}" is guaranteed by the above symlink command.
symlink "zprofile" "${XDG_CONFIG_HOME}/zsh/.zprofile"
symlink "zshrc" "${XDG_CONFIG_HOME}/zsh/.zshrc"
symlink "${XDG_CONFIG_HOME}/editorconfig/config" "${HOME}/.editorconfig"

if [ -t 0 ] && [ ! -f "${LOCAL_GITCONFIG}" ]; then
  _default_username="$(git config --global user.name 2>/dev/null || true)"
  _default_useremail="$(git config --global user.email 2>/dev/null || true)"

  _git_username="$(prompt "Git user.name" "${_default_username}")"
  _git_useremail="$(prompt "Git user.email" "${_default_useremail}")"

  if [ -n "${_git_username}" ] && [ -n "${_git_useremail}" ]; then
    git config -f "${LOCAL_GITCONFIG}" user.name "${_git_username}"
    git config -f "${LOCAL_GITCONFIG}" user.email "${_git_useremail}"
  fi
  unset _default_username _default_useremail _git_username _git_useremail
fi

for script in "${BASE_DIR}/bin"/*; do
  [ -e "${script}" ] || continue
  symlink "${script}" "${BIN_DIR}/$(basename "${script}")"
done
unset script

download "${BOLD_ITALICS_URL}" "${BIN_DIR}/bold-italics" "+x"
download "${COLOR_256_URL}" "${BIN_DIR}/256colors2" "+x"
download "${COLOR_SPACES_URL}" "${BIN_DIR}/color-spaces" "+x"
download "${GIT_PROMPT_URL}" "${GIT_COMPLETION_DIR}/git-prompt.sh"
download "${IMGCAT_URL}" "${BIN_DIR}/imgcat" "+x"
download "${IMGLS_URL}" "${BIN_DIR}/imgls" "+x"
download "${OTHER_SGR_URL}" "${BIN_DIR}/other-sgr" "+x"
download "${QUERY_COLOR_URL}" "${BIN_DIR}/query-color" "+x"
download "${QUERY_DYNAMIC_URL}" "${BIN_DIR}/query-dynamic" "+x"
download "${QUERY_FONTS_URL}" "${BIN_DIR}/query-fonts" "+x"
download "${TEST_FONTS_URL}" "${BIN_DIR}/test-fonts" "+x"
download "${WEZTERM_SHELL_INTEGRATION_URL}" \
  "${WEZTERM_SHELL_INTEGRATION_DIR}/wezterm.sh"

# shellcheck disable=SC2310
if ! has mise; then
  download "${MISE_INSTALL_URL}" | sh 2>/dev/null || true
fi

# shellcheck disable=SC2310
if has mise; then
  mise install --yes || true
fi

run_hook post-setup
