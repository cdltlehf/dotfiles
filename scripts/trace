#!/bin/sh

set -o nounset
set -o errexit

if [ $# -lt 1 ]; then
  echo "Usage: $0 <bash|zsh> [flags...]" >&2
  exit 1
fi

shell_bin="$1"
shift 1

if ! command -v "${shell_bin}" >/dev/null 2>&1; then
  echo "Shell binary not found: ${shell_bin}" >&2
  exit 1
fi

shell_name="$(basename "${shell_bin}")"

is_login=0
if [ $# -eq 0 ]; then
  set -- -l -i
  is_login=1
else
  for _a in "$@"; do
    case "${_a}" in
    --interactive) set -- "$@" "-i" ;;
    --login | -l)
      set -- "$@" "-l"
      is_login=1
      ;;
    *) set -- "$@" "${_a}" ;;
    esac
    shift
  done
  unset _a
fi

case "${shell_name}" in
zsh | bash)
  ;;
*)
  echo "Unsupported shell: ${shell_name}" >&2
  exit 2
  ;;
esac

case "${shell_name}" in
zsh)
  "${shell_bin}" --sourcetrace "$@" -c exit 2>&1 |
    LC_ALL=C sed -E -n 's/^\++([^:]+):[0-9]+>.*$/\1/p'
  ;;
bash)
  if [ "${is_login}" -eq 1 ]; then
    printf "%s\n" "${HOME}/.bash_profile"
  else
    printf "%s\n" "${HOME}/.bashrc"
  fi
  "${shell_bin}" -x "$@" -c exit 2>&1 |
    LC_ALL=C sed -n -E 's/^\++[[:space:]]*(source|\.)[[:space:]]+(\/[^[:space:]]+).*/\2/p'
  ;;
*)
  exit 1
  ;;
esac |
  awk '!seen[$0]++ && /^\//' |
  paste -sd: -
