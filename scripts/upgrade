#!/bin/sh

set -o nounset
set -o errexit

export __DOTFILES_UPGRADE=1

BASE_DIR="$(cd "$(dirname "$0")/.." && pwd)"
readonly BASE_DIR

# shellcheck source=scripts/lib.sh
. "${BASE_DIR}/scripts/lib.sh"

OS="$(detect_os)"
ARCH="$(detect_arch)"
export OS ARCH
readonly OS ARCH

run_hook pre-upgrade

if command -v brew >/dev/null; then
  brew update
  if [ -f "${BASE_DIR}/platforms/${OS}/Brewfile" ]; then
    brew bundle --file "${BASE_DIR}/platforms/${OS}/Brewfile"
  fi
  brew upgrade
fi

if command -v mise >/dev/null; then
  mise install --yes
  mise upgrade --bump
fi

prek_update_projection() {
  _dir="$(mktemp -d)"
  _config="${_dir}/prek.toml"
  sed -e 's/{open}/{/g' -e 's/{close}/}/g' "$1" >"${_config}"
  prek update -c "${_config}"
  sed -e 's/{/@OPEN@/g' -e 's/}/@CLOSE@/g' \
    -e 's/@OPEN@/{open}/g' -e 's/@CLOSE@/{close}/g' "${_config}" >"$1"
  rm -rf "${_dir}"
}

if command -v prek >/dev/null; then
  prek update
  prek update -c "${BASE_DIR}/xdg-templates-dir/prek.toml"
  prek_update_projection "${BASE_DIR}/xdg-templates-dir/python/prek.toml.tmpl"
fi

if command -v nvim >/dev/null; then
  nvim --headless \
    -c "lua vim.pack.update(nil, { force = true })" \
    -c "qall!"
fi

run_hook post-upgrade
