#!/bin/bash

set -o nounset
set -o errexit

BASE_DIR="$(cd "$(dirname "$0")/.." && pwd)"
readonly BASE_DIR

# shellcheck source=scripts/lib.sh
. "${BASE_DIR}/scripts/lib.sh"

REPO="${1:-}"
MODAL="${2:-text}"
FILE="${3:-}"
PATTERN="${4:-}"

if [[ -z "${REPO}" ]]; then
  cat <<'EOF' >&2
Usage:
  make models-download REPO=<repo> [MODAL=text|audio|image|embedding] [FILE=<file>|PATTERN=<pattern>]

Arguments:
  REPO     Hugging Face repository (e.g. owner/name)
  MODAL    Model category: text, audio, image, embedding (defaults to "text")
  FILE     Specific filename to download
  PATTERN  Include glob pattern (e.g. "*.gguf")
EOF
  exit 1
fi

case "${MODAL}" in
text | responses)
  dest="${XDG_DATA_HOME:-${HOME}/.local/share}/models/responses"
  ;;
audio)
  dest="${XDG_DATA_HOME:-${HOME}/.local/share}/models/audio"
  ;;
image | images)
  dest="${XDG_DATA_HOME:-${HOME}/.local/share}/models/images"
  ;;
embedding | embeddings)
  dest="${XDG_DATA_HOME:-${HOME}/.local/share}/models/embeddings"
  ;;
*)
  error "Invalid MODAL '${MODAL}'. Must be one of: text, audio, image, embedding"
  exit 1
  ;;
esac

mkdir -p "${dest}"

if command -v hf >/dev/null 2>&1; then
  hf_cmd="hf"
elif command -v huggingface-cli >/dev/null 2>&1; then
  hf_cmd="huggingface-cli"
else
  error "Neither 'hf' nor 'huggingface-cli' is installed."
  exit 1
fi

args=("${hf_cmd}" download "${REPO}" --local-dir "${dest}")
if [[ -n "${FILE}" ]]; then
  args+=("${FILE}")
elif [[ -n "${PATTERN}" ]]; then
  args+=(--include "${PATTERN}")
fi

"${args[@]}"
