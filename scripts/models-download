#!/bin/sh
#
# Reference: https://huggingface.co/docs/huggingface_hub/guides/cli

set -o nounset
set -o errexit

BASE_DIR="$(cd "$(dirname "$0")/.." && pwd)"
readonly BASE_DIR

# shellcheck source=scripts/lib.sh
. "${BASE_DIR}/scripts/lib.sh"

REPO="${1:-}"
PATTERN="${2:-}"
DEST="${3:-responses}"

usage() {
  cat <<'EOF'
Usage:
  make models-download REPO=<repo> [PATTERN=<pattern>] [DEST=<endpoint>]

Arguments:
  REPO     Hugging Face repository (e.g. unsloth/gemma-4-12b-it-GGUF)
  PATTERN  File pattern to download (e.g. "*Q4_K_M.gguf", defaults to "*")
  DEST     Model category under ~/.local/share/models:
           responses, embeddings, audio, images (defaults to "responses")

Examples:
  make models-download REPO=unsloth/gemma-4-12b-it-GGUF PATTERN="*Q4_K_M.gguf" DEST=responses
  make models-download REPO=BAAI/bge-m3 PATTERN="*.gguf" DEST=embeddings
  make models-download REPO=ggerganov/whisper.cpp PATTERN="ggml-base.bin" DEST=audio
  make models-download REPO=stabilityai/sd-turbo PATTERN="*.safetensors" DEST=images
EOF
}

if [ -z "${REPO}" ]; then
  usage
  exit 0
fi

if ! command -v huggingface-cli >/dev/null 2>&1; then
  error "huggingface-cli is not installed."
  echo "Install it via your package manager, mise, or pip (e.g. brew install huggingface-cli)" >&2
  exit 1
fi

case "${DEST}" in
responses | embeddings | audio | images) ;;
*)
  error "invalid DEST '${DEST}'. Must be one of: responses, embeddings, audio, images"
  exit 1
  ;;
esac

MODELS_DIR="${XDG_DATA_HOME:-${HOME}/.local/share}/models/${DEST}"
mkdir -p "${MODELS_DIR}"

if [ "${DEST}" = "responses" ] || [ "${DEST}" = "embeddings" ]; then
  REPO_NAME="$(basename "${REPO}")"
  TARGET_DIR="${MODELS_DIR}/${REPO_NAME}"
  mkdir -p "${TARGET_DIR}"
else
  TARGET_DIR="${MODELS_DIR}"
fi

printf "Downloading from %s (%s) into %s ...\n" "${REPO}" "${PATTERN:-*.*}" "${TARGET_DIR}"

if [ -n "${PATTERN}" ]; then
  huggingface-cli download "${REPO}" \
    --include "${PATTERN}" \
    --local-dir "${TARGET_DIR}" \
    --local-dir-use-symlinks False
else
  huggingface-cli download "${REPO}" \
    --local-dir "${TARGET_DIR}" \
    --local-dir-use-symlinks False
fi
