#!/bin/sh
#
# Reference: https://google.github.io/styleguide/shellguide.html

set -o nounset
set -o errexit

BASE_DIR="$(cd "$(dirname "$0")/.." && pwd)"
readonly BASE_DIR

# shellcheck source=scripts/lib.sh
. "${BASE_DIR}/scripts/lib.sh"

SUBCOMMAND_DIR="${BASE_DIR}/scripts/models.d"
readonly SUBCOMMAND_DIR

cmd="${1:-}"
case "${cmd}" in
"" | -h | --help | help)
  printf "Usage: %s <audio|chat|download|images|link|list> [args...]\n" "$0"
  exit 0
  ;;
*) ;;
esac

target="${SUBCOMMAND_DIR}/${cmd}"
[ -f "${target}" ] || die "Unknown models subcommand: ${cmd}"

shift 1
exec "${target}" "$@"
