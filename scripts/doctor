#!/bin/sh

set -o nounset
set -o errexit

export __DOTFILES_DOCTOR=1

BASE_DIR="$(cd "$(dirname "$0")/.." && pwd)"
readonly BASE_DIR

# shellcheck source=scripts/lib.sh
. "${BASE_DIR}/scripts/lib.sh"

OS="$(detect_os)"
ARCH="$(detect_arch)"
export OS ARCH
readonly OS ARCH

run_hook pre-doctor

printf "OS: %s\n" "${OS}"
printf "ARCH: %s\n" "${ARCH}"

# shellcheck disable=SC2310
if has brew; then
  printf "\nHomebrew:\n"
  brew doctor || true
fi

# shellcheck disable=SC2310
if has mise; then
  printf "\nmise:\n"
  mise doctor || true
fi

run_hook post-doctor
