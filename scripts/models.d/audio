#!/bin/sh
#
# Reference: https://curl.se/docs/manpage.html
# Reference: https://platform.openai.com/docs/api-reference/audio

set -o nounset
set -o errexit

BASE_DIR="$(cd "$(dirname "$0")/../.." && pwd)"
readonly BASE_DIR

# shellcheck source=scripts/lib.sh
. "${BASE_DIR}/scripts/lib.sh"

BASE_URL="${BASE_URL:-http://localhost:8080/v1}"
API_KEY="${API_KEY:-no-key}"
readonly BASE_URL API_KEY

AUDIO_FILE="${1:-}"
if [ -z "${AUDIO_FILE}" ] || [ ! -f "${AUDIO_FILE}" ]; then
  die "Usage: $0 <audio_file>"
fi

curl -fsS "${BASE_URL}/audio/transcriptions" \
  -H "Authorization: Bearer ${API_KEY}" \
  -F "file=@${AUDIO_FILE}" \
  -F "response_format=json" | jq .
