#!/bin/sh
#
# Reference: https://huggingface.co/docs/huggingface_hub/guides/download
# Reference: https://google.github.io/styleguide/shellguide.html

set -o nounset
set -o errexit

BASE_DIR="$(cd "$(dirname "$0")/../.." && pwd)"
readonly BASE_DIR

# shellcheck source=scripts/lib.sh
. "${BASE_DIR}/scripts/lib.sh"

MODELS_DIR="${XDG_DATA_HOME:-${HOME}/.local/share}/models"
readonly MODELS_DIR

if ! command -v hf >/dev/null; then
  die "hf command not found. Please install huggingface_hub first."
fi

mkdir -p "${MODELS_DIR}"

if [ $# -ge 2 ]; then
  exec hf download "$1" "$2" --local-dir "${MODELS_DIR}"
fi

if [ -f "${BASE_DIR}/.env" ]; then
  # shellcheck source=/dev/null
  . "${BASE_DIR}/.env"
fi

if [ -z "${MODELS_DOWNLOAD:-}" ]; then
  die "No models specified. Provide arguments or define MODELS_DOWNLOAD in .env."
fi

for item in ${MODELS_DOWNLOAD}; do
  repo="${item%%:*}"
  rest="${item#*:}"
  file="${rest%%:*}"
  target_dir="${MODELS_DIR}"
  if [ "${rest}" != "${file}" ]; then
    target_dir="${MODELS_DIR}/${rest#*:}"
  fi
  info "Fetching ${file} (${repo})..."
  hf download "${repo}" "${file}" --local-dir "${target_dir}"
done
unset item repo rest file target_dir
