#!/bin/sh
#
# Reference: https://curl.se/docs/manpage.html
# Reference: https://platform.openai.com/docs/api-reference/models

set -o nounset
set -o errexit

BASE_URL="${BASE_URL:-http://localhost:8080/v1}"
API_KEY="${API_KEY:-no-key}"
readonly BASE_URL API_KEY

curl -fsS "${BASE_URL}/models" \
  -H "Authorization: Bearer ${API_KEY}" | jq .
