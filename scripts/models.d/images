#!/bin/sh
#
# Reference: https://curl.se/docs/manpage.html
# Reference: https://platform.openai.com/docs/api-reference/images

set -o nounset
set -o errexit

BASE_DIR="$(cd "$(dirname "$0")/../.." && pwd)"
readonly BASE_DIR

# shellcheck source=scripts/lib.sh
. "${BASE_DIR}/scripts/lib.sh"

BASE_URL="${BASE_URL:-http://localhost:8080/v1}"
API_KEY="${API_KEY:-no-key}"
PROMPT="${1:-A cat sitting on a windowsill}"
OUTPUT_FILE="${2:-${TMPDIR:-/tmp}/output.png}"
readonly BASE_URL API_KEY OUTPUT_FILE

PAYLOAD="$(jq -n \
  --arg prompt "${PROMPT}" \
  '{
    prompt: $prompt,
    negative_prompt: "low quality",
    n: 1,
    size: "1024x1024",
    response_format: "b64_json"
  }')"

RESPONSE="$(curl -fsS "${BASE_URL}/images/generations" \
  -H "Authorization: Bearer ${API_KEY}" \
  -H "Content-Type: application/json" \
  -d "${PAYLOAD}")"

B64="$(printf "%s" "${RESPONSE}" | jq -r '.data[0].b64_json // empty')"
[ -n "${B64}" ] || die "Failed to generate image: ${RESPONSE}"

printf "%s" "${B64}" | base64 -d >"${OUTPUT_FILE}"
printf "%s\n" "${OUTPUT_FILE}"
