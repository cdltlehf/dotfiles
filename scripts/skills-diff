#!/bin/sh
#
# Reference: https://skills.sh/

set -o nounset
set -o errexit

BASE_DIR="$(cd "$(dirname "$0")/.." && pwd)"
readonly BASE_DIR
readonly MANIFEST="${MANIFEST:-${BASE_DIR}/xdg-config-home/agents/skills.json}"
readonly LOCK_FILE="${LOCK_FILE:-${XDG_STATE_HOME:-${HOME}/.local/state}/skills/.skill-lock.json}"
readonly SKILLS_DIR="${SKILLS_DIR:-${HOME}/.agents/skills}"

if [ ! -f "${MANIFEST}" ]; then
  exit 0
fi

tmpdir="$(mktemp -d)"
trap 'rm -rf "${tmpdir}"' EXIT

jq -r '.repositories[]? // empty' "${MANIFEST}" | sort -u >"${tmpdir}/desired-repos.txt"
if [ -f "${LOCK_FILE}" ]; then
  jq -r '.skills[]?.source // empty' "${LOCK_FILE}" | sort -u >"${tmpdir}/current-repos.txt"
else
  : >"${tmpdir}/current-repos.txt"
fi

comm -13 "${tmpdir}/current-repos.txt" "${tmpdir}/desired-repos.txt" |
  while IFS= read -r repo; do
    [ -n "${repo}" ] || continue
    echo "Missing from installed skills: ${repo}"
  done

comm -23 "${tmpdir}/current-repos.txt" "${tmpdir}/desired-repos.txt" |
  while IFS= read -r repo; do
    [ -n "${repo}" ] || continue
    echo "Missing from skills.json: ${repo}"
  done

jq -r '.custom[]? // empty' "${MANIFEST}" | sort -u >"${tmpdir}/desired-custom.txt"

if [ -d "${SKILLS_DIR}" ]; then
  for item in "${SKILLS_DIR}"/*; do
    [ -e "${item}" ] || [ -L "${item}" ] || continue
    name="$(basename "${item}")"
    if [ -L "${item}" ] && [ ! -e "${item}" ]; then
      target="$(readlink "${item}" || true)"
      echo "Broken link in ~/.agents/skills: ${name} -> ${target}"
    fi
  done

  for item in "${SKILLS_DIR}"/*; do
    [ -d "${item}" ] || continue
    name="$(basename "${item}")"
    case "${name}" in
    .* | synced) continue ;;
    *) ;;
    esac
    [ -f "${item}/SKILL.md" ] || continue
    if [ ! -f "${LOCK_FILE}" ] || ! jq -e --arg name "${name}" '.skills[$name] != null' "${LOCK_FILE}" >/dev/null 2>&1; then
      echo "${name}" >>"${tmpdir}/current-custom.txt"
    fi
  done
  [ -f "${tmpdir}/current-custom.txt" ] || : >"${tmpdir}/current-custom.txt"
  sort -u -o "${tmpdir}/current-custom.txt" "${tmpdir}/current-custom.txt"
else
  : >"${tmpdir}/current-custom.txt"
fi

comm -13 "${tmpdir}/current-custom.txt" "${tmpdir}/desired-custom.txt" |
  while IFS= read -r skill; do
    [ -n "${skill}" ] || continue
    echo "Missing custom skill from ~/.agents/skills: ${skill}"
  done

comm -23 "${tmpdir}/current-custom.txt" "${tmpdir}/desired-custom.txt" |
  while IFS= read -r skill; do
    [ -n "${skill}" ] || continue
    echo "Untracked custom skill in ~/.agents/skills: ${skill}"
  done
