FROM docker.io/library/python:3.12-slim

RUN pip install --no-cache-dir "google-adk[a2a,mcp]" litellm && \
    adk telemetry disable

WORKDIR /app

COPY --chmod=0755 entrypoint.sh /app/entrypoint.sh
COPY plugins.py /usr/local/lib/python3.12/site-packages/plugins.py

EXPOSE 8000
ENTRYPOINT ["/app/entrypoint.sh"]
CMD ["/app/agents"]
