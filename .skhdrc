# https://github.com/koekeishiya/yabai/blob/master/examples/yabairc
alt - return : open -a /Applications/iTerm.app
alt + shift - return : open -a /Applications/Google\ Chrome.app

alt - o : \
  if [ `yabai -m query --windows --window | jq '."zoom-fullscreen"'` = 1 ]; then\
    yabai -m window --toggle zoom-fullscreen; \
  fi; \
  yabai -m window --focus next || yabai -m window --focus first
alt - h : \
  if [ `yabai -m query --windows --window | jq '."zoom-fullscreen"'` = 1 ]; then\
    yabai -m window --toggle zoom-fullscreen; \
  fi; \
  yabai -m window --focus west
alt - j : \
  if [ `yabai -m query --windows --window | jq '."zoom-fullscreen"'` = 1 ]; then\
    yabai -m window --toggle zoom-fullscreen; \
  fi; \
  yabai -m window --focus south
alt - k : \
  if [ `yabai -m query --windows --window | jq '."zoom-fullscreen"'` = 1 ]; then\
    yabai -m window --toggle zoom-fullscreen; \
  fi; \
  yabai -m window --focus north;
alt - l : \
  if [ `yabai -m query --windows --window | jq '."zoom-fullscreen"'` = 1 ]; then\
    yabai -m window --toggle zoom-fullscreen; \
  fi; \
  yabai -m window --focus east;

shift + alt - o : yabai -m window --swap next || yabai -m window --swap first
shift + alt - h : \
  if [ `yabai -m query --windows --window | jq .floating` = 0 ]; then\
    yabai -m window --swap west; \
  else \
    yabai -m window --grid 1:2:0:0:1:1; \
  fi;

shift + alt - j : \
  if [ `yabai -m query --windows --window | jq .floating` = 0 ]; then\
    yabai -m window --swap south; \
  else \
    yabai -m window --grid 4:4:1:1:2:2; \
  fi;

shift + alt - k : \
  if [ `yabai -m query --windows --window | jq .floating` = 0 ]; then\
    yabai -m window --swap north; \
  else \
    yabai -m window --grid 1:1:0:0:1:1; \
  fi;

shift + alt - l : \
  if [ `yabai -m query --windows --window | jq .floating` = 0 ]; then\
    yabai -m window --swap east; \
  else \
    yabai -m window --grid 1:2:1:0:1:1; \
  fi;

shift + alt - 0 : yabai -m space --balance

alt - n : yabai -m space --focus next
alt - p : yabai -m space --focus prev

shift + alt - n : yabai -m window --space next; yabai -m space --focus next
shift + alt - p : yabai -m window --space prev; yabai -m space --focus prev

alt - z : yabai -m window --toggle zoom-fullscreen
alt - f : yabai -m window --toggle native-fullscreen

ctrl + alt - h : yabai -m window --insert west
ctrl + alt - j : yabai -m window --insert south
ctrl + alt - k : yabai -m window --insert north
ctrl + alt - l : yabai -m window --insert east

alt - e : yabai -m window --toggle split

alt - t : yabai -m window --toggle float;\
          yabai -m window --grid 4:4:1:1:2:2
