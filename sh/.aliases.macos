#!/usr/bin/sh

# Lsd
[ -e "$(brew --prefix)/bin/lsd" ] && alias ls="$(brew --prefix)/bin/lsd"

# Bat
# shellcheck disable=SC2139
if command -v bat > /dev/null 2>&1; then
  alias cat='bat --theme=dracula --paging=never'
fi
alias bathelp='bat --theme=dracula --plain --language=help'

export MANPAGER="sh -c 'col -bx | bat --theme=dracula -l man -p'"

help() {
    "$@" --help 2>&1 | bathelp
}
