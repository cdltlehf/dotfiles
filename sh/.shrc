#!/usr/bin/env sh
#
# ~/.shrc
# Shell-independent startup file (for any kind of shells)

if [ -n "${HOME_SHRC_SOURCED}" ]; then
  echo "${HOME}/.shrc sourced twice!"
fi
HOME_SHRC_SOURCED="1"

# User specific environment
PATH="${HOME}/bin:${PATH}"
PATH="${HOME}/.local/bin:${PATH}"
PATH="${HOME}/dotfiles/bin:${PATH}"
PATH="${HOME}/Library/Python/3.11/bin:${PATH}"
export PATH

# Set locale
export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8

# Cygwin environment variables
# https://cygwin.com/cygwin-ug-net/using-cygwinenv.html
export CYGWIN=winsymlinks:nativestrict
export MSYS="${CYGWIN}"

if tty >/dev/null 2>&1; then
  stty stop ''; stty start ''
fi

# Inspect processes on GPUs
nvidia_ps() {
  _pids="$(nvidia-smi pmon -c 1 | awk '/^#/{next}{if ($2 != "-") print $2}')"
  if [ -n "${_pids}" ]; then
    echo "${_pids}" | xargs ps "$@"
  else
    echo "No processes are running."
  fi
  unset _pids
}
alias -- nvidia-ps="nvidia_ps"

# Alias podman to docker
if ! command docker 2> /dev/null; then
  alias docker='podman'
  alias docker-run='podman-run'
fi

# Source shell-independent external configurations
# shellcheck disable=2066,1090
for file in "${HOME}/.aliases"; do
  [ -f "${file}" ] && . "${file}"
done;
unset file;

# vim:ft=sh:ts=2:sts=2:sw=2:et:sta
