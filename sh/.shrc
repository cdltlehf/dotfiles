#!/usr/bin/env sh
#
# ~/.shrc
# Shell-independent startup file (for any kind of shells)

if [ -n "${__HOME_SHRC_SOURCED}" ]; then
  echo "${HOME}/.shrc sourced twice!"
fi
__HOME_SHRC_SOURCED="1"

# Source files in .shrc.d
if [ -d "${HOME}/.shrc.d" ]; then
  for file in "${HOME}"/.shrc.d/*.sh; do
    # shellcheck source=/dev/null
    . "${file}"
  done
fi

# User specific environment
PATH="${HOME}/.local/bin:${PATH}"
PATH="${HOME}/.local/usr/bin:${PATH}"
PATH="${HOME}/dotfiles/bin:${PATH}"
export PATH

# Set locale
export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8

# Export editors
export VISUAL='vim';
export EDITOR='vim -E';
export PAGER='less';

# https://github.com/rust-lang/rustup
# TODO: Find more detailed relative link
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

# https://github.com/nvm-sh/nvm
export NVM_DIR="$HOME/.local/share/nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"

# Cygwin environment variables
# https://cygwin.com/cygwin-ug-net/using-cygwinenv.html
export CYGWIN=winsymlinks:nativestrict
export MSYS="${CYGWIN}"

# TODO: Find related link
if tty >/dev/null 2>&1; then
  stty stop ''; stty start ''
fi

# Source shell-independent external configurations
[ -f "HOME"/.aliases ] && . "${HOME}/.aliases"

# vim:ft=sh:ts=2:sts=2:sw=2:et:sta
